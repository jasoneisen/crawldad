# Crawldad.Portal — multi-stage container image.
#
# The customer-facing portal: a .NET 10 Blazor Web App (Interactive Server render mode, no WebAssembly) with its own
# Marten document store on the SAME Postgres as the API, isolated in the code-configured "portal" schema. It is
# self-contained — it does NOT reference Crawldad.Api/Contracts, so its restore graph is just the Marten package. This
# image publishes a Release build on the .NET 10 SDK pinned by global.json and runs it on the aspnet runtime base as a
# non-root user. It is built server-side by `az acr build` in the deploy workflow (no local docker needed there);
# `docker build -f Dockerfile.portal .` from the repo root works identically for local validation.
#
# Ports: the aspnet base sets ASPNETCORE_HTTP_PORTS=8080 and Kestrel listens there, which is the Container Apps ingress
# targetPort (same as the API image).
#
# Schema: unlike the API, the portal has NO out-of-band `db-apply` command — its Program.cs always serves and takes no
# CLI verbs. Development applies the schema on startup; every other environment relies on Marten's default runtime
# auto-create (AutoCreate.CreateOrUpdate) to materialize the "portal" schema on first document use. The anonymous
# marketing "/" route touches no database, so the container boots and serves before any schema exists.

# syntax=docker/dockerfile:1

# The SDK/runtime major is 10.0; global.json (copied into the restore layer) pins the exact SDK feature band
# (10.0.3xx, rollForward latestFeature), so the build fails loudly if the base image ever drifts below it.
ARG DOTNET_SDK_TAG=10.0
ARG DOTNET_RUNTIME_TAG=10.0

# ── Build + publish ────────────────────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_TAG} AS build
WORKDIR /src

# Restore layer: copy ONLY the files that affect restore first, so the (slow) NuGet restore layer is cached and
# reused across source-only edits. Central package versions + shared build props govern every project. The portal has
# no ProjectReference, so its own csproj is the only project file the restore graph needs.
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Crawldad.Portal/Crawldad.Portal.csproj src/Crawldad.Portal/
RUN dotnet restore src/Crawldad.Portal/Crawldad.Portal.csproj

# Source layer: only the portal's own source (no sibling projects — the portal references none). The repo .editorconfig
# carries the analyzer severity config (e.g. CA1062/MA0048 = none); it MUST be present at build time or those rules fire
# as errors under warnings-as-errors. Placed at the WORKDIR root so it governs all of src/.
COPY .editorconfig ./
COPY src/Crawldad.Portal/ src/Crawldad.Portal/

# Publish Release. TreatWarningsAsErrors + analyzers are inherited from Directory.Build.props (config-agnostic), so any
# warning fails this build exactly as CI does. UseAppHost=false: we launch via `dotnet Crawldad.Portal.dll`, so no
# native apphost is needed. The Web SDK compiles the Blazor static web assets (Tabler CSS/JS under wwwroot) into the
# published output for MapStaticAssets. SourceRevisionId stamps the build commit into the assembly for traceability.
ARG SOURCE_REVISION_ID=""
RUN dotnet publish src/Crawldad.Portal/Crawldad.Portal.csproj \
      -c Release -o /app --no-restore \
      /p:UseAppHost=false \
      /p:SourceRevisionId=${SOURCE_REVISION_ID}

# ── Runtime ────────────────────────────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_RUNTIME_TAG} AS final
WORKDIR /app

# The aspnet base already exports ASPNETCORE_HTTP_PORTS=8080; document the listen port for humans + tooling.
EXPOSE 8080

COPY --from=build /app ./

# Run as the base image's non-root user (APP_UID=1654). The portal writes nothing to the container filesystem; the
# persisted Data Protection key ring and blob storage are API concerns, not the portal's.
USER $APP_UID

# The portal always serves (no CLI verbs): `dotnet Crawldad.Portal.dll` boots Kestrel on 8080. See Program.cs.
ENTRYPOINT ["dotnet", "Crawldad.Portal.dll"]
