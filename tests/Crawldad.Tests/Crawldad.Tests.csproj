<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Coverage gate (coverlet.msbuild, VSTest mode — .NET 10's default test runner can't gate coverage).
       Enforces 100% line+branch of shipped code; during local iteration override with
       /p:CollectCoverage=false for a quick run. -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/</CoverletOutput>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <!-- Measure ONLY product assemblies (excludes the test assembly + framework). -->
    <Include>[Crawldad.Api]*,[Crawldad.Contracts]*,[Crawldad.Client]*,[Crawldad.Portal]*</Include>
    <!-- Don't count trivial auto-property accessors on DTOs/aggregates. -->
    <SkipAutoProps>true</SkipAutoProps>
    <!-- Exclude framework source-generated dispatchers (Marten/JasperFx/Wolverine evolvers) and the entry-point
         shell. Program.cs is listed explicitly so a future file that happens to be named Program.cs is still
         counted rather than silently dropped from the gate. -->
    <ExcludeByFile>**/obj/**/*.cs,**/src/Crawldad.Api/Program.cs,**/src/Crawldad.Portal/Program.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Alba" />
    <PackageReference Include="Shouldly" />
    <!-- Portal (Blazor SSR) tests. -->
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Real-Chromium integration tests: drive the local adapter, start a local Playwright run-server for the
         native-connect path, and launch a CDP endpoint for the connectOverCDP path. -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- The opt-in Azurite suite drives the Azure blob adapter against the emulator (no live traffic). -->
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Crawldad.Api\Crawldad.Api.csproj" />
    <ProjectReference Include="..\..\src\Crawldad.Contracts\Crawldad.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Crawldad.Client\Crawldad.Client.csproj" />
    <ProjectReference Include="..\..\src\Crawldad.Portal\Crawldad.Portal.csproj" />
  </ItemGroup>

  <!-- The suite hosts the ASP.NET app (Alba) and tests its Data-Protection wiring, so reference the shared framework
       explicitly. This also lets restore PRUNE the framework-provided packages the Data-Protection blob/key extensions
       drag in transitively via the netstandard2.0 Microsoft.AspNetCore.DataProtection 3.1.32 dep — otherwise their
       legacy System.Drawing.Common 4.7.0 closure trips the repo's NuGetAudit (as it is already pruned in Crawldad.Api). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- Test data assets (the acceptance fragment payload). Resolved at runtime via AppContext.BaseDirectory.
       The caphome-search fixture (manifest/html/golden) copies transitively from Crawldad.Api. -->
  <ItemGroup>
    <Content Remove="Fixtures\**\*" />
    <None Remove="Fixtures\**\*" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Serialize collections (xunit.runner.json: parallelizeTestCollections=false + maxParallelThreads=1): the ~15
       integration/parity/leak/durable/webhook collections each stand up their own Alba host — a full Marten schema
       migration — against one shared Postgres, and every concurrent host also runs a live Wolverine durability agent.
       Any overlap is what makes CI flake (issue #106): concurrent migrations contend on Postgres's per-database advisory
       lock ("Unable to attain a global lock in time"), and a host torn down while another is live throws
       ObjectDisposedException from the surviving agent. A "modest cap" of 2 left the class intermittently red. Note
       maxParallelThreads=1 alone is NOT strict: its single-worker sync context still lets collection runners interleave
       at await points, so two fixtures' async InitializeAsync migrations (I/O-bound awaits) can be in flight against
       Postgres at once — and their Wolverine agents run on the real thread pool, outside that sync context. So we ALSO
       disable collection parallelization, which runs collections strictly one-at-a-time. Production runs a SINGLE host,
       so this is the faithful topology, not a throttle — and the cost is small now that #105 dropped suite time to
       ~1 min (measured: ~62 s at 2-way vs ~110 s serialized, both far under the old ~21 min). -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
