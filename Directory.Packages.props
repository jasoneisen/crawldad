<Project>

  <!-- Central Package Management: every version is declared once, here. Projects reference by name only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Critter Stack (Marten + Wolverine)">
    <PackageVersion Include="Marten" Version="9.30.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.32.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.32.0" />
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="6.32.0" />
    <!-- Wolverine 6 moved the runtime Roslyn compiler out of core; this re-enables dynamic codegen.
         Production can instead pre-generate code (codegen write) and set TypeLoadMode.Static. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.32.0" />
    <!-- JasperFx (the db-*/projections/codegen CLI) and FluentValidation arrive transitively via the packages
         above; pinned explicitly so the versions are visible and so the slices that already consume them — the
         AbstractValidator<T>s under Features/ — compile without any project choosing a version of its own.
         JasperFx tracks the spine Wolverine resolves (Weasel rides along transitively). -->
    <PackageVersion Include="JasperFx" Version="2.59.0" />
    <!-- Rides along transitively only where Wolverine 6.32 pulls it up: the Portal hosts standalone Marten with no
         Wolverine, so unpinned it resolves Marten 9.30's own floor (2.56.0) while Api/Tests resolve 2.59.0. -->
    <PackageVersion Include="JasperFx.Events" Version="2.59.0" />
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup Label="Browser / DOM">
    <!-- The expression evaluator's read-only DOM builtins and the record/replay fake backend parse captured HTML
         with AngleSharp. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <!-- The record/replay fake's structured-Sel `xpath` variant evaluates XPath over the AngleSharp DOM to
         model Playwright's `xpath=` selector engine (the real backend uses Playwright's own engine). AngleSharp.XPath
         is the AngleSharp-native XPath extension (INode.SelectNodes); MIT, tracks AngleSharp 1.x. -->
    <PackageVersion Include="AngleSharp.XPath" Version="2.0.6" />
    <!-- Phase 4 real backend adapters wrap Playwright for .NET 1:1 (the shared PlaywrightBrowserSession and the
         local/browserless/browserbase adapters). Pinned to 1.61.0 — the Chromium headless-shell/full v1228 build
         (Chrome 149) is pre-installed under ~/.cache/ms-playwright for this line. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <!-- The durable Azure Blob storage adapter (deployment target is Azure — docs/ARCHITECTURE.md). Pinned to 12.21.2,
         the build cached in this environment; its transitive Azure.Core/Azure.Storage.Common are auto-pinned above. The
         adapter is exercised against the Azurite emulator (opt-in local + CI service), never live storage. -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.21.2" />
  </ItemGroup>

  <ItemGroup Label="Console auth (issue #119 PR2)">
    <!-- The config-gated ConsolePrincipal JwtBearer scheme validates the portal UAMI's first-party Entra access token
         (v1.0 shape, AppRole-gated). Registered ONLY when Crawldad:ConsoleAuth is configured; absent that config the
         scheme is never added and ApiKey stays the sole/default scheme. Its Microsoft.IdentityModel.* closure
         (Protocols.OpenIdConnect/Tokens/JsonWebTokens 8.0.1) is auto-pinned by transitive pinning above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Data Protection key ring (Azure)">
    <!-- Persist the ASP.NET Data Protection key ring so registered browser credentials survive redeploys (issue #65):
         the ring is stored in a blob and each key wrapped by a Key Vault key, both reached with the app's managed
         identity (Azure.Identity/DefaultAzureCredential). Wired only when the DataProtection section is configured;
         absent config keeps the default local key ring, so dev/tests are untouched. Transitive Azure.Core/
         Azure.Security.KeyVault.Keys are auto-pinned by transitive pinning above. -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.3.4" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.2.4" />
    <PackageVersion Include="Azure.Identity" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup Label="Client SDK">
    <!-- The typed client SDK (src/Crawldad.Client) is a plain class library, so it references the HTTP factory
         package explicitly (the API host gets it from the ASP.NET shared framework). Pinned to the .NET 10 wave that
         matches the rest of the solution; its Microsoft.Extensions.* transitive closure is auto-pinned above. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <!-- Payload validation-at-save: the JSON Schema (schema/crawldad-1.schema.json) is enforced by
         JsonSchema.Net — the de-facto System.Text.Json-native JSON Schema engine. Pinned to 8.0.0, the last
         MIT-licensed line (9.x switched to the Open Source Maintenance Fee EULA). Its transitive deps
         (JsonPointer.Net/Json.More.Net/Humanizer.Core, all MIT) are auto-pinned by transitive pinning above. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.4" />
    <PackageVersion Include="Alba" Version="8.5.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <!-- Portal (Blazor SSR) tests: bUnit for component/layout/nav rendering; WebApplicationFactory (Mvc.Testing)
         drives the real OTP HTTP flow with cookies + antiforgery + redirects. -->
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <!-- Extra linters, applied to every project (PrivateAssets=all is implied by GlobalPackageReference). -->
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="2.0.224" />
  </ItemGroup>

</Project>
