# Crawldad connector reverse proxy (template).
#
# entrypoint.sh renders this to a writable path with the two runtime ports
# substituted (render_nginx_conf in lib.sh): __PROXY_PORT__ is the port nginx
# listens on for the tunnel, __CDP_PORT__ is Chromium's loopback DevTools port it
# proxies to. Editing the literal ports here has no effect; set CDP_PORT /
# PROXY_PORT instead (they default to 9222 / 9223 and must differ).
#
# Chromium's remote-debugging endpoint rejects any request whose Host header is
# not localhost/an IP (a DNS-rebinding guard): the /json HTTP endpoints answer
# 500 "Host header is specified and is not an IP address or localhost.", and the
# /devtools/browser/<id> WebSocket upgrade is refused with 403. A request
# arriving via the tunnel carries Host: <sub>.trycloudflare.com, so this proxy
# rewrites Host to Chromium's loopback address before forwarding. It also carries
# the WebSocket upgrade through for the long-lived CDP connection. (The exact
# codes are Chromium's own and can drift between versions.)
#
# Runs unprivileged: no `user` directive, a high listen port, and every writable
# path lives under /tmp/crawldad-connector.

worker_processes 1;
pid /tmp/crawldad-connector/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    access_log off;

    client_body_temp_path /tmp/crawldad-connector/nginx/client_body;
    proxy_temp_path /tmp/crawldad-connector/nginx/proxy;
    fastcgi_temp_path /tmp/crawldad-connector/nginx/fastcgi;
    uwsgi_temp_path /tmp/crawldad-connector/nginx/uwsgi;
    scgi_temp_path /tmp/crawldad-connector/nginx/scgi;

    # WebSocket upgrade plumbing for the CDP connection.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 127.0.0.1:__PROXY_PORT__;
        server_name _;

        # The DevTools port only trusts a localhost Host header.
        proxy_set_header Host "127.0.0.1:__CDP_PORT__";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # CDP sessions are long-lived and idle between commands.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;

        location / {
            proxy_pass http://127.0.0.1:__CDP_PORT__;
        }
    }
}
