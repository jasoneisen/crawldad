@inherits LayoutComponentBase
@using Crawldad.Client
@using Crawldad.Contracts.Tenancy
@using Crawldad.Portal.Tenancy
@inject IPortalTenantContext Tenants

@*
    The authenticated app shell: a Tabler vertical navbar (Runs / Live / Payloads / Webhooks / Account) with a live
    slot/queue usage indicator pinned to its foot, and a top bar showing the signed-in email plus a sign-out control.
    Only ever rendered for [Authorize] pages, so the cascaded HttpContext.User is an authenticated principal — its email
    claim is read directly (static SSR, no circuit). The layout renders STATICALLY even for the one interactive page
    (the live trace), so the usage widget resolves the tenant + reads usage on that page's initial static render like any
    other /app page; on a circuit (no ambient HttpContext) the tenant context resolves null and the widget quietly shows
    its placeholder. Every failure mode (unauthenticated, unlinked, a rotated key ring, an API hiccup) degrades to that
    placeholder — a data problem in the chrome must never break the shell.
*@
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-brand navbar-brand-autodark d-flex align-items-center gap-2 mb-2 mt-1">
                <a href="/app" class="d-flex align-items-center gap-2 text-reset text-decoration-none">
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="32" height="32" rx="8" fill="url(#cd-brand)" />
                        <path d="M8.5 10.5c4.4 0 7.6 2.4 7.6 5.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
                        <path d="M8.5 21.5c4.4 0 7.6-2.4 7.6-5.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
                        <path d="M16.1 16h5.2M20 12.7l3.4 3.3-3.4 3.3" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                        <defs>
                            <linearGradient id="cd-brand" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#5b7cff" />
                                <stop offset="1" stop-color="#3550c9" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <span class="d-flex flex-column">
                        <span class="brand-text">Crawl<span class="brand-accent">dad</span></span>
                        <span class="brand-sub">portal</span>
                    </span>
                </a>
            </div>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <AppNav />
                <div class="usage-indicator mt-auto p-3" data-testid="usage-indicator">
                    <div class="usage-label text-uppercase fw-bold mb-2">Usage</div>
                    @if (_snapshot is { } snapshot)
                    {
                        var usage = snapshot.Usage;
                        var profile = snapshot.Profile;
                        var slotPct = Pct(usage.Slots.InUse, usage.Slots.Allowance);
                        <div class="usage-row d-flex justify-content-between mb-1">
                            <span>Slots</span>
                            <span data-testid="usage-slots">@usage.Slots.InUse / @usage.Slots.Allowance</span>
                        </div>
                        <div class="progress usage-meter mb-2">
                            <div class="progress-bar" style="width:@(slotPct)%" role="progressbar" aria-label="Slot usage" aria-valuenow="@slotPct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="usage-row d-flex justify-content-between">
                            <span>Queue</span>
                            <span data-testid="usage-queue">@usage.Queue.Depth / @profile.QueueDepthAllowance</span>
                        </div>
                    }
                    else
                    {
                        @* Quiet placeholder: unauthenticated / not linked / a data hiccup (rotated ring or API error).
                           The Account page carries the actionable link / usage / re-link states — the chrome stays calm. *@
                        <div class="usage-row d-flex justify-content-between mb-1">
                            <span>Slots</span>
                            <span data-testid="usage-slots">— / —</span>
                        </div>
                        <div class="progress usage-meter mb-2">
                            <div class="progress-bar" style="width: 0%" role="progressbar" aria-label="Slot usage" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="usage-row d-flex justify-content-between">
                            <span>Queue</span>
                            <span data-testid="usage-queue">idle</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>
    <div class="page-wrapper">
        <header class="navbar navbar-expand-md d-print-none sticky-top border-bottom">
            <div class="container-xl">
                @* Workspace switcher (issue #119 PR6): the active workspace, with a dropdown to switch when the account
                   holds more than one. Single-workspace (or stored-key mode) shows the name as static text. Each switch is
                   an antiforgery-protected POST that persists the selection server-side, then reloads scoped to it. *@
                @if (_workspaces.Count > 0)
                {
                    var active = _workspaces.FirstOrDefault(w => w.IsActive);
                    <div class="navbar-nav flex-row me-auto align-items-center" data-testid="workspace-switcher">
                        @if (_workspaces.Count == 1)
                        {
                            <span class="nav-item text-secondary d-flex align-items-center" data-testid="workspace-current">
                                <span class="text-uppercase small me-2">Workspace</span>
                                <span class="fw-semibold">@(active?.Label ?? _workspaces[0].Label)</span>
                            </span>
                        }
                        else
                        {
                            <div class="nav-item dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-testid="workspace-menu">
                                    <span class="text-uppercase small text-secondary me-1">Workspace</span>
                                    <span class="fw-semibold" data-testid="workspace-active">@(active?.Label ?? "Select")</span>
                                </button>
                                <div class="dropdown-menu">
                                    @foreach (var ws in _workspaces)
                                    {
                                        @if (ws.IsActive)
                                        {
                                            <span class="dropdown-item active" data-testid="workspace-option">@ws.Label</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/app/workspace" class="d-block">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="workspace" value="@ws.TenantId" />
                                                <button type="submit" class="dropdown-item" data-testid="workspace-option">@ws.Label</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
                    <span class="avatar avatar-sm me-2" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                    </span>
                    <span class="nav-item me-3 text-secondary" data-testid="user-email">@UserEmail</span>
                    <form method="post" action="/auth/signout" class="nav-item">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary btn-sm" data-testid="sign-out">Sign out</button>
                    </form>
                </div>
            </div>
        </header>
        <div class="page-body">
            <div class="container-xl">
                @Body
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    // The loaded usage snapshot, set only when BOTH reads succeed for a linked user — a single nullable so the widget
    // branches on one flag (present → live numbers, absent → the quiet placeholder), never on a half-loaded pair.
    private (UsageResponse Usage, TenantProfileResponse Profile)? _snapshot;

    // The switcher's workspaces (issue #119 PR6). Empty until a linked user resolves; one entry in stored-key mode (single
    // workspace) or when the console list can't be read; many in console-mode multi-workspace.
    private IReadOnlyList<WorkspaceOption> _workspaces = [];

    private string? UserEmail => HttpContext.User.FindFirstValue(ClaimTypes.Email);

    protected override async Task OnInitializedAsync()
    {
        // Resolve the tenant, then load the usage mini-widget and the switcher's workspace list — all best-effort, once per
        // request (the tenant context caches within the request; no cross-request caching — the numbers stay fresh). An
        // unauthenticated request or a circuit (the context returns null with no ambient HttpContext), a rotated key ring
        // (CryptographicException), or any API failure leaves the chrome in its quiet placeholder state — a data hiccup must
        // never break the shell. The usage read and the workspace read are independent, so one failing never hides the other.
        PortalTenant? tenant;
        try
        {
            tenant = await Tenants.TryResolveAsync();
        }
        catch (Exception)
        {
            return; // unresolvable link (e.g. rotated ring) → quiet placeholder, no switcher
        }

        if (tenant is null)
        {
            return; // unauthenticated / not linked / no ambient HttpContext → the quiet placeholder
        }

        var profile = await LoadSnapshotAsync(tenant);
        _workspaces = await BuildWorkspacesAsync(tenant, profile);
    }

    // Reads the tenant profile + usage for the mini-widget; sets _snapshot when both land, else leaves it null (placeholder).
    // Returns the profile (or null) so the switcher can label a single stored-key workspace with its display name.
    private async Task<TenantProfileResponse?> LoadSnapshotAsync(PortalTenant tenant)
    {
        try
        {
            var profile = await tenant.Client.GetTenantAsync();
            var usage = await tenant.Client.GetUsageAsync();
            _snapshot = (usage, profile);
            return profile;
        }
        catch (Exception)
        {
            _snapshot = null; // any hiccup keeps the quiet placeholder — never a broken shell
            return null;
        }
    }

    // The switcher's workspace list: console-mode reads the authoritative GET /workspaces (multi-workspace); stored-key mode
    // (or a console list that couldn't be read) shows just the active workspace. Never throws — the chrome must not break.
    private static async Task<IReadOnlyList<WorkspaceOption>> BuildWorkspacesAsync(PortalTenant tenant, TenantProfileResponse? profile)
    {
        if (tenant.AuthMode == PortalAuthMode.Console)
        {
            try
            {
                var list = await tenant.Client.ListMyWorkspacesAsync();
                return [.. list.Workspaces.Select(w => new WorkspaceOption(
                    w.TenantId, w.DisplayName, string.Equals(w.TenantId, tenant.TenantId, StringComparison.Ordinal)))];
            }
            catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
            {
                // Couldn't list — degrade to the single active workspace below.
            }
        }

        var label = profile?.DisplayName is { Length: > 0 } name ? name : tenant.TenantId;
        return [new WorkspaceOption(tenant.TenantId, label, true)];
    }

    // Percentage (0..100) of a value against a cap, guarding a zero/absent allowance (mirrors the Account page's meter).
    private static int Pct(long value, long max) => max <= 0 ? 0 : (int)Math.Min(100, Math.Round(100.0 * value / max));

    // One entry in the workspace switcher — the tenant id the switch posts, its display label, and whether it is active.
    private sealed record WorkspaceOption(string TenantId, string Label, bool IsActive);
}
