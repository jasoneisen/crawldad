@*
    Marketing pages ("/", "/login") default to MarketingLayout; the authenticated app pages set @layout AppLayout
    themselves. Unauthenticated requests to an [Authorize] page are turned away by the authorization middleware
    (a 302 to the cookie handler's LoginPath), so no client-side authorization view is needed here.
*@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MarketingLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
