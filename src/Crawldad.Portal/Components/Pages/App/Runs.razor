@page "/app/runs"
@layout AppLayout
@attribute [Authorize]
@using Crawldad.Contracts.Runs
@using Crawldad.Portal.Runs
@using Crawldad.Portal.Tenancy
@inject IPortalTenantContext Tenant

<PageTitle>Runs · Crawldad</PageTitle>

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h1 class="page-title">Runs</h1>
        </div>
    </div>
</div>

@if (_result is null)
{
    <div class="card mt-3">
        <WorkspaceEmptyState Configured="Tenant.ConsoleConfigured" />
    </div>
}
else
{
    <div class="card mt-3 mb-3">
        <div class="card-body py-2">
            <ul class="nav nav-pills" data-testid="status-filter">
                <li class="nav-item">
                    <a class="nav-link @RunView.NavActiveCss(_status, null)" href="@RunView.ListUrl(null, _payloadId, From, To, null, _size)">All</a>
                </li>
                @foreach (var option in _statusOptions)
                {
                    <li class="nav-item">
                        <a class="nav-link @RunView.NavActiveCss(_status, option)" href="@RunView.ListUrl(option, _payloadId, From, To, null, _size)">@option</a>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (_result.Runs.Count == 0)
    {
        <div class="card" data-testid="no-runs">
            <div class="empty">
                @if (_filtered)
                {
                    <p class="empty-title">No runs match</p>
                    <p class="empty-subtitle text-secondary">No runs match the current filter. Clear it to see the rest of your runs.</p>
                }
                else
                {
                    <p class="empty-title">No runs yet</p>
                    <p class="empty-subtitle text-secondary">Every scrape or search run streams in here as it moves through queued, running, and terminal states.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Recent runs</h3>
                <div class="card-actions text-secondary">@_result.Total runs</div>
            </div>
            <div class="card-table table-responsive">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Run</th>
                            <th>Payload</th>
                            <th>Duration</th>
                            <th>Steps · Req · Misses</th>
                            <th>Started</th>
                            <th>Region</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in _result.Runs)
                        {
                            <tr data-testid="run-row">
                                <td>
                                    <span class="status @RunView.StatusCss(run.Status)"><span class="status-dot"></span>@run.Status</span>
                                    @if (run.Failure is not null)
                                    {
                                        <div class="run-failure" data-testid="row-failure">
                                            <span class="mono text-danger">@run.Failure.Code</span>
                                            <span class="text-secondary">@run.Failure.Class</span>
                                        </div>
                                    }
                                </td>
                                <td><a href="/app/runs/@run.RunId" class="run-id fw-bold">@RunView.ShortId(run.RunId)</a></td>
                                <td class="payload-cell">
                                    @if (run.Inline)
                                    {
                                        <span>@run.PayloadName</span> <span class="rev-pill">inline</span>
                                    }
                                    else
                                    {
                                        <span>@run.PayloadName</span>
                                        @if (run.PayloadRevision is not null)
                                        {
                                            <span class="rev-pill">r@(run.PayloadRevision)</span>
                                        }
                                    }
                                </td>
                                <td><span class="mono">@RunView.Duration(run.DurationMs)</span></td>
                                <td>
                                    @if (run.Stats is not null)
                                    {
                                        <span class="metric-triad">
                                            <span class="m" title="Semantic steps">@run.Stats.Steps</span>
                                            <span class="m" title="Requests issued">@run.Stats.Requests</span>
                                            <span class="@RunView.MissesCss(run.Stats.SelectorMisses)" title="Selector misses — the soft drift signal">@run.Stats.SelectorMisses</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                                <td class="text-secondary mono">@RunView.Timestamp(run.StartedAt)</td>
                                <td>
                                    @if (run.Region is not null)
                                    {
                                        <span class="region">@run.Region</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between">
                <p class="m-0 text-secondary" data-testid="page-summary">
                    Showing <strong>@_firstRow</strong> to <strong>@_lastRow</strong> of <strong>@_result.Total</strong> runs
                </p>
                <ul class="pagination m-0">
                    @if (_result.Page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" data-testid="page-prev" href="@RunView.ListUrl(_status, _payloadId, From, To, _result.Page - 1, _size)">prev</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">prev</span></li>
                    }
                    <li class="page-item active"><span class="page-link" data-testid="page-current">@_result.Page</span></li>
                    @if (_result.HasMore)
                    {
                        <li class="page-item">
                            <a class="page-link" data-testid="page-next" href="@RunView.ListUrl(_status, _payloadId, From, To, _result.Page + 1, _size)">next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">next</span></li>
                    }
                </ul>
            </div>
        </div>
    }
}

@code {
    private static readonly RunStatus[] _statusOptions =
        [RunStatus.Succeeded, RunStatus.Failed, RunStatus.Running, RunStatus.Queued, RunStatus.Cancelled];

    // Raw query values (tolerantly parsed in OnInitializedAsync). Bound as strings so a malformed value degrades to
    // "no filter"/"default page" instead of throwing during query binding.
    [Parameter, SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "payloadId")] public string? PayloadId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "size")] public string? Size { get; set; }

    // The parsed filter/paging state, shared by the API call and the filter/pager link builders.
    private RunStatus? _status;
    private Guid? _payloadId;
    private int? _size;
    private bool _filtered;

    // Null once resolved => the account is not linked to a tenant (the not-linked empty state); otherwise the page.
    private RunListResponse? _result;
    private int _firstRow;
    private int _lastRow;

    protected override async Task OnInitializedAsync()
    {
        _status = RunView.ParseStatus(Status);
        _payloadId = RunView.ParsePayloadId(PayloadId);
        _size = RunView.ParseSize(Size);
        var from = RunView.ParseInstant(From);
        var to = RunView.ParseInstant(To);
        _filtered = RunView.HasFilter(_status, _payloadId, from, to);

        var tenant = await Tenant.TryResolveAsync();
        if (tenant is null)
        {
            return; // no active workspace / console unconfigured => the empty state (points at Account)
        }

        var page = RunView.ParsePage(Page);
        _result = await tenant.Client.ListRunsAsync(_status, _payloadId, from, to, page, _size);
        _firstRow = ((_result.Page - 1) * _result.Size) + 1;
        _lastRow = _firstRow + _result.Runs.Count - 1;
    }
}
