@using Crawldad.Contracts.Payloads

@*
    Renders the API's payload-validation problems verbatim — each error's JSON-Pointer path, its stable code, and the
    human-readable message exactly as the server returned them. The portal never authors or paraphrases these; it only
    surfaces them. Also used for the portal's own well-formedness (invalid_json) pre-flight problem, which shares the
    identical shape. Renders nothing when there are no problems.
*@
@if (Errors is { } errors)
{
    <div class="alert alert-danger" role="alert" data-testid="payload-problems">
        <div class="fw-semibold mb-2">@Title</div>
        <ul class="list-unstyled m-0">
            @foreach (var error in errors)
            {
                <li class="mb-1" data-testid="payload-problem">
                    <code>@(string.IsNullOrEmpty(error.Path) ? "(root)" : error.Path)</code>
                    <span class="badge bg-red-lt ms-1" data-testid="problem-code">@error.Code</span>
                    <span class="ms-1">@error.Message</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    /// <summary>The validation problems to render verbatim (path + code + message).</summary>
    [Parameter]
    public IReadOnlyList<PayloadValidationError>? Errors { get; set; }

    /// <summary>The heading shown above the list.</summary>
    [Parameter]
    public string Title { get; set; } = "The payload was rejected:";
}
