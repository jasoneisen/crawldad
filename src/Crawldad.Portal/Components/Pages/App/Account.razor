@page "/app/account"
@layout AppLayout
@attribute [Authorize]
@using System.Globalization
@using Crawldad.Client
@using Crawldad.Contracts.Billing
@using Crawldad.Contracts.Tenancy
@using Crawldad.Portal.Tenancy
@inject IPortalTenantContext Tenants
@inject IWorkspaceLinker Linker
@inject IPortalWorkspaceSelectionStore Selections
@inject NavigationManager Nav

<PageTitle>Account &amp; usage · Crawldad</PageTitle>

@*
    The account area (issue #119 — simplified workspace surface). The portal is console-mode only for data: there is no stored
    tenant key. A workspace's IDENTITY is its display name everywhere; the raw workspace id appears in exactly ONE place — the
    copyable "Workspace ID" field below, for API/SDK use. Single-workspace-first: a solo user sees plan/usage/keys with the
    workspace name as a heading and no switcher/team chrome; the switch list and the full member-management section appear only
    once there is more than one workspace / member. The "create a free workspace" and tucked-away "claim an existing workspace"
    actions are the only ways to gain a workspace here. When console access is unconfigured on the deployment, every data
    section reads an honest "console access not configured" — never a 500.
*@
@{
    // The understated "claim an existing workspace" disclosure and the "invite a teammate" form, each defined once here and
    // rendered in whichever branch applies below (mutually exclusive, so a form name never renders twice per request).
    // Declared before first use so the generated render method has them in scope wherever the markup references them.
    RenderFragment ClaimDisclosure =@<details class="mt-2" data-testid="claim-disclosure">
        <summary class="text-secondary" style="cursor: pointer;">Claim an existing workspace</summary>
        <div class="mt-3">
            <p class="text-secondary small">
                Have an operator-provisioned workspace and its API key? Paste them to prove access — we verify the key against
                the API, record your membership, and <b>never store the key</b>. From then on the portal reaches the workspace
                through console access.
            </p>
            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert" data-testid="link-error">@_error</div>
            }
            <EditForm id="link-form" Model="Input" FormName="workspace-link" OnValidSubmit="HandleLinkAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label" for="tenantId">Workspace ID</label>
                        <InputText id="tenantId" class="form-control" autocomplete="off" spellcheck="false" @bind-Value="Input.TenantId" />
                        <ValidationMessage For="() => Input.TenantId" />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label" for="apiKey">API key</label>
                        @* Manual input with no value attribute: the secret binds IN on POST but is never rendered back OUT. *@
                        <input id="apiKey" name="Input.ApiKey" type="password" class="form-control" autocomplete="off" spellcheck="false" placeholder="Paste your API key" />
                        <ValidationMessage For="() => Input.ApiKey" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-outline-primary" data-testid="link-submit">Verify &amp; claim</button>
                </div>
            </EditForm>
        </div>
    </details>;

    RenderFragment AddMemberForm =@<div>
        <hr class="my-3" />
        <div class="fw-semibold mb-2">Invite a teammate</div>
        <p class="text-secondary small">They sign in with email OTP; their access is scoped to the role you pick. Only Owners can manage keys, members, and billing.</p>
        <form method="post" action="/app/members/add" data-testid="add-member-form">
            <AntiforgeryToken />
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="member-email">Email</label>
                    <input id="member-email" name="email" type="email" class="form-control" autocomplete="off" spellcheck="false" placeholder="teammate@example.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="member-role">Role</label>
                    <select id="member-role" name="role" class="form-select">
                        <option value="@MembershipRole.Member">Member</option>
                        <option value="@MembershipRole.Owner">Owner</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100" data-testid="add-member-submit">Add member</button>
                </div>
            </div>
        </form>
    </div>;
}
<div class="page-header d-flex align-items-baseline justify-content-between">
    <div>
        <h1 class="page-title">Account &amp; usage</h1>
        @if (_hasWorkspace)
        {
            <div class="text-secondary" data-testid="workspace-heading">@WorkspaceName</div>
        }
    </div>
</div>

@if (ShowClaimed)
{
    <div class="alert alert-success mt-3" role="status" data-testid="link-success">
        <div class="d-flex">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
            </div>
            <div>Workspace ready. Your plan and usage are shown below.</div>
        </div>
    </div>
}

<!-- Profile -->
<div class="card mt-3" id="profile">
    <div class="card-header"><h3 class="card-title">Profile</h3></div>
    <div class="card-body">
        <dl class="account-kv mb-0">
            <dt>Signed in as</dt>
            <dd data-testid="account-email">@Email</dd>

            <dt>Workspace</dt>
            <dd>
                @if (_workspaceUnavailable)
                {
                    <span class="status status-yellow" data-testid="link-status">
                        <span class="status-dot"></span>Workspace unavailable
                    </span>
                }
                else if (_hasWorkspace)
                {
                    <span class="status status-green" data-testid="link-status">
                        <span class="status-dot"></span>@WorkspaceName
                    </span>
                    @if (_myMembership is not null)
                    {
                        <span class="ms-2 text-secondary" data-testid="membership-status">@_myMembership.Role.ToString()</span>
                    }
                }
                else if (!_configured)
                {
                    <span class="status status-secondary" data-testid="link-status">
                        <span class="status-dot"></span>Console access not configured
                    </span>
                }
                else
                {
                    <span class="status status-secondary" data-testid="link-status">
                        <span class="status-dot"></span>No workspace yet
                    </span>
                }
            </dd>

            @if (_hasWorkspace && !_workspaceUnavailable)
            {
                @* The ONE place the raw workspace id is surfaced — for API/SDK/CLI use. Copyable; never the identity. *@
                <dt>Workspace ID</dt>
                <dd>
                    <div class="input-group input-group-flat" style="max-width: 26rem;">
                        <input id="workspace-id" class="form-control cd-mono" readonly value="@_tenantId" onclick="this.select()" data-testid="workspace-id" />
                        <span class="input-group-text p-0">
                            <button type="button" class="btn btn-sm btn-ghost-secondary" data-testid="workspace-id-copy"
                                    onclick="navigator.clipboard.writeText(document.getElementById('workspace-id').value);this.textContent='Copied';">Copy</button>
                        </span>
                    </div>
                    <div class="text-secondary small mt-1">Use this for the API and SDK (the <span class="cd-mono">X-Crawldad-Workspace</span> / tenant id). Your display name is your workspace's identity in the portal.</div>
                </dd>
            }

            <dt>Session</dt>
            <dd>
                @* Reuse the existing sign-out endpoint (same antiforgery-protected POST the shell header uses). *@
                <form method="post" action="/auth/signout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" data-testid="account-sign-out">Sign out</button>
                </form>
            </dd>
        </dl>
    </div>
</div>

@if (!_configured)
{
    <!-- Console access unconfigured (an operator misconfig): honest state, never a 500. -->
    <div class="card mt-3" data-testid="console-unconfigured">
        <div class="card-body">
            <div class="empty">
                <p class="empty-title">Console access isn't configured</p>
                <p class="empty-subtitle text-secondary">
                    This deployment isn't configured for console access, so your workspace's plan, usage, keys, and members
                    can't be shown here. Contact your operator.
                </p>
            </div>
        </div>
    </div>
}
else if (_workspaceUnavailable)
{
    <!-- The active workspace is forbidden by the console gate (the user was removed, or an operator suspended it). Every
         console read — including GET /workspaces — 403s under this selector, so there is no in-page switch to offer: give an
         honest escape (contact the operator, or claim a workspace the user still holds a key for). Never a 500. -->
    <div class="card mt-3" id="workspace-unavailable" data-testid="workspace-unavailable">
        <div class="card-header"><h3 class="card-title">Workspace unavailable</h3></div>
        <div class="card-body">
            <p class="text-secondary">
                Your active workspace can't be reached — you may have been removed from it, or an operator suspended it.
                Contact your operator to restore access, or claim a workspace you still have an API key for below.
            </p>
            @ClaimDisclosure
        </div>
    </div>
}
else if (!_hasWorkspace)
{
    <!-- Get started: the ONE create-free-workspace affordance, plus the tucked-away claim disclosure. -->
    <div class="card mt-3" id="get-started" data-testid="get-started">
        <div class="card-header"><h3 class="card-title">Get started</h3></div>
        <div class="card-body">
            <p class="text-secondary">You don't have a workspace yet. Create your free workspace to get started.</p>
            @if (!string.IsNullOrEmpty(ProvisionError))
            {
                <div class="alert alert-danger" role="alert" data-testid="provision-error">@ProvisionError</div>
            }
            <form method="post" action="/app/workspace/provision" data-testid="provision-form">
                <AntiforgeryToken />
                <div class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label" for="provision-name">Workspace name</label>
                        <input id="provision-name" name="displayName" class="form-control" autocomplete="off" spellcheck="false" placeholder="My workspace" maxlength="200" />
                    </div>
                    <div class="col-md-5">
                        <button type="submit" class="btn btn-primary" data-testid="provision-submit">Create your free workspace</button>
                    </div>
                </div>
            </form>

            @ClaimDisclosure
        </div>
    </div>
}
else
{
    <!-- Plan & usage -->
    <div class="card mt-3" id="usage">
        <div class="card-header">
            <h3 class="card-title">Plan &amp; usage</h3>
            @if (_profile is not null)
            {
                <div class="card-actions text-secondary small">@PlanLabel(_profile) · live</div>
            }
        </div>
        <div class="card-body">
            @if (_usageError)
            {
                <div class="empty" data-testid="usage-error">
                    <p class="empty-title">Usage is unavailable right now</p>
                    <p class="empty-subtitle text-secondary">
                        We couldn't read your usage from the API. Try again shortly.
                    </p>
                </div>
            }
            else
            {
                // Reached only with a resolved workspace and no load error, so both are set — capture non-null locals.
                var usage = _usage!;
                var profile = _profile!;
                <div class="row g-3" data-testid="usage-panel">
                    <div class="col-sm-6 col-xl-4">
                        <div class="datacard h-100">
                            <div class="kpi-sub">Slots in use</div>
                            <div class="kpi" data-testid="usage-slots">@usage.Slots.InUse <span class="kpi-of">/ @usage.Slots.Allowance</span></div>
                            <div class="meter mt-2"><span style="width:@(Pct(usage.Slots.InUse, usage.Slots.Allowance))%"></span></div>
                            <div class="text-secondary kpi-note">Concurrent runs admitted right now.</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="datacard h-100">
                            <div class="kpi-sub">Queue depth</div>
                            <div class="kpi" data-testid="usage-queue">@usage.Queue.Depth <span class="kpi-of">/ @profile.QueueDepthAllowance</span></div>
                            <div class="meter mt-2"><span style="width:@(Pct(usage.Queue.Depth, profile.QueueDepthAllowance))%"></span></div>
                            <div class="text-secondary kpi-note">Runs wait here at the slot cap — no 429 until it fills.</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-4">
                        <div class="datacard h-100">
                            <div class="kpi-sub">p95 queue wait</div>
                            <div class="kpi" data-testid="usage-p95">@FormatWait(usage.Queue.P95WaitMs)</div>
                            <div class="text-secondary kpi-note">Across @usage.Queue.Sampled promoted run(s). Sustained wait is the "add slots" signal.</div>
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="fw-semibold mb-3">Guardrails <span class="text-secondary fw-normal small">— headroom before the hard ceilings</span></div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="small">Events / run (peak)</span>
                                <span class="mono small" data-testid="usage-events">@usage.Events.Max <span class="text-secondary">/ @usage.Events.Guardrail</span></span>
                            </div>
                            <div class="meter"><span style="width:@(Pct(usage.Events.Max, usage.Events.Guardrail))%"></span></div>
                            <div class="text-secondary kpi-note">Peak over the last @usage.Events.Sampled run(s) · avg @usage.Events.Avg.</div>
                        </div>
                        <div class="datacard">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="small">Runs started this month</span>
                                <span class="kpi-inline mono" data-testid="usage-runs">@usage.RunsStartedThisMonth</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="fw-semibold mb-3">Plan</div>
                        <dl class="account-kv">
                            <dt>Tier</dt>
                            <dd data-testid="plan-tier">@PlanLabel(profile)</dd>
                            <dt>Concurrent slots</dt>
                            <dd>@profile.SlotAllowance</dd>
                            <dt>Queue depth</dt>
                            <dd>@profile.QueueDepthAllowance</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Billing -->
    <div class="card mt-3" id="billing">
        <div class="card-header"><h3 class="card-title">Billing</h3></div>
        <div class="card-body">
            @if (_billingConfig is not { Configured: true } billing)
            {
                <div class="empty" data-testid="billing-unavailable">
                    <p class="empty-title">Billing not yet available</p>
                    <p class="empty-subtitle text-secondary">
                        Plan changes, invoices, and payment method will open in Stripe. Nothing to do here yet.
                    </p>
                </div>
            }
            else
            {
                <div data-testid="billing-panel">
                    <p class="text-secondary">
                        Your plan is <span class="fw-semibold" data-testid="billing-current">@CurrentPlanLabel(billing)</span>.
                        Upgrading opens Stripe Checkout; "Manage billing" opens the Stripe billing portal. Your plan changes
                        only after checkout completes.
                    </p>
                    <div class="row g-3">
                        @foreach (var tier in billing.Tiers)
                        {
                            <div class="col-sm-6 col-lg-3">
                                <div class="datacard h-100 @(tier.IsCurrent ? "border-primary" : "")">
                                    <div class="fw-semibold">@tier.DisplayName</div>
                                    <div class="kpi-inline">@tier.PriceLabel</div>
                                    @if (tier.Slots is int slots)
                                    {
                                        <div class="text-secondary small">@slots concurrent slots</div>
                                    }
                                    <div class="mt-2">
                                        @if (tier.IsCurrent)
                                        {
                                            <span class="badge bg-primary" data-testid="billing-tier-current">Current plan</span>
                                        }
                                        else if (tier.SelfServe)
                                        {
                                            <form method="post" action="/app/billing/checkout">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="tier" value="@tier.Tier" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm" data-testid="billing-upgrade-@tier.Tier">
                                                    Choose @tier.DisplayName
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">Contact sales</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <form method="post" action="/app/billing/portal">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary" data-testid="billing-manage">Manage billing</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- API keys -->
    <div class="card mt-3 mb-3" id="apikeys">
        <div class="card-header"><h3 class="card-title">API keys</h3></div>
        <div class="card-body">
            @if (_keysOperatorManaged)
            {
                <div data-testid="keys-operator-managed">
                    <p class="mb-1">This workspace's API keys are managed by the Crawldad operator.</p>
                    <p class="text-secondary mb-0 small">
                        Self-service key management isn't available for this workspace. For your security, key material is
                        never displayed here.
                    </p>
                </div>
            }
            else if (_keysError)
            {
                <div class="empty" data-testid="keys-error">
                    <p class="empty-title">Keys are unavailable right now</p>
                    <p class="empty-subtitle text-secondary">We couldn't read your keys from the API. Try again shortly.</p>
                </div>
            }
            else
            {
                @if (_mintedKey is not null)
                {
                    <div class="alert alert-success" role="status" data-testid="minted-key">
                        <div class="fw-semibold mb-1">New API key@(_mintedLabel is null ? "" : $" ({_mintedLabel})") — copy it now</div>
                        <p class="text-secondary small mb-2">
                            This is the only time the full key is shown. Store it somewhere safe — you can't see it again.
                        </p>
                        <div class="input-group">
                            @* Show-once: rendered on THIS response only, never persisted by the portal and never in a later GET. *@
                            <input id="minted-key" class="form-control cd-mono" readonly value="@_mintedKey" onclick="this.select()" data-testid="minted-key-value" />
                            <button type="button" class="btn btn-outline-primary" data-testid="minted-key-copy"
                                    onclick="navigator.clipboard.writeText(document.getElementById('minted-key').value);this.textContent='Copied';">Copy</button>
                        </div>
                    </div>
                }

                @if (_keysActionError is not null)
                {
                    <div class="alert alert-danger" role="alert" data-testid="keys-action-error">@_keysActionError</div>
                }

                @if (RevokeConfirmTarget() is { } toRevoke)
                {
                    <div class="card mb-3 border-danger" data-testid="revoke-confirm">
                        <div class="card-body">
                            <h3 class="mb-1">Revoke key @toRevoke.Prefix…?</h3>
                            <p class="text-secondary">Any client using this key stops working immediately. This can't be undone.</p>
                            @if (IsLastActiveKey())
                            {
                                <p class="text-secondary" data-testid="revoke-last-note">
                                    This is your workspace's last API key. You'll still reach this workspace through the portal
                                    (console access) — but any API or SDK client will need a newly minted key.
                                </p>
                            }
                            <EditForm FormName="revoke-key" Model="RevokeForm" OnValidSubmit="RevokeKeyAsync" data-testid="revoke-form">
                                <input type="hidden" name="RevokeForm.KeyId" value="@toRevoke.KeyId" />
                                <button type="submit" class="btn btn-danger" data-testid="revoke-submit">Revoke key</button>
                                <a href="/app/account" class="btn btn-link">Cancel</a>
                            </EditForm>
                        </div>
                    </div>
                }

                @if (RotateConfirmTarget() is { } toRotate)
                {
                    <div class="card mb-3 border-warning" data-testid="rotate-confirm">
                        <div class="card-body">
                            <h3 class="mb-1">Rotate key @toRotate.Prefix…?</h3>
                            <p class="text-secondary">
                                A new key is minted and this one is revoked immediately. Any client using the old key must
                                switch to the new one.
                            </p>
                            <EditForm FormName="rotate-key" Model="RotateForm" OnValidSubmit="RotateKeyAsync" data-testid="rotate-form">
                                <input type="hidden" name="RotateForm.KeyId" value="@toRotate.KeyId" />
                                <button type="submit" class="btn btn-warning" data-testid="rotate-submit">Rotate key</button>
                                <a href="/app/account" class="btn btn-link">Cancel</a>
                            </EditForm>
                        </div>
                    </div>
                }

                @if (_keys.Count == 0)
                {
                    <p class="text-secondary" data-testid="keys-empty">No keys yet — mint one below.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr><th>Key</th><th>Label</th><th>Created</th><th>Last used</th><th>Status</th><th class="w-1"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var key in _keys)
                                {
                                    <tr data-testid="key-row">
                                        <td class="cd-mono">@key.Prefix…</td>
                                        <td>@(key.Label ?? "—")</td>
                                        <td class="text-secondary">@FormatUtc(key.CreatedAt)</td>
                                        <td class="text-secondary">@(key.LastUsedAt is { } used ? FormatUtc(used) : "—")</td>
                                        <td>
                                            @if (key.Active)
                                            {
                                                <span class="badge bg-green-lt" data-testid="key-status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-lt" data-testid="key-status-revoked">Revoked</span>
                                            }
                                        </td>
                                        <td>
                                            @if (key.Active)
                                            {
                                                <a href="@($"/app/account?rotate={key.KeyId}#apikeys")" class="btn btn-sm btn-ghost-secondary" data-testid="rotate-link">Rotate</a>
                                                <a href="@($"/app/account?revoke={key.KeyId}#apikeys")" class="btn btn-sm btn-ghost-danger" data-testid="revoke-link">Revoke</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <hr class="my-3" />
                <div class="fw-semibold mb-2">Mint a new key</div>
                <p class="text-secondary small">
                    Use keys to authenticate the API and the SDK. Rotating replaces a key without a gap; your workspace's last
                    key can be revoked because console access can always get you back in.
                </p>
                <EditForm FormName="mint-key" Model="Mint" OnValidSubmit="MintKeyAsync" data-testid="mint-form">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label" for="key-label">Label <span class="text-secondary fw-normal">(optional)</span></label>
                            <InputText id="key-label" class="form-control" autocomplete="off" spellcheck="false" placeholder="e.g. ci, laptop, mcp-agent" @bind-Value="Mint.Label" />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100" data-testid="mint-submit">Mint key</button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </div>

    @* Workspaces switch list — single-workspace-first: renders ONLY when the account has more than one workspace. *@
    @if (IsMultiWorkspace)
    {
        <div class="card mt-3" id="workspaces">
            <div class="card-header"><h3 class="card-title">Workspaces</h3></div>
            <div class="card-body">
                <p class="text-secondary">The workspaces you can act as. Switching changes the active workspace for every page.</p>
                <div class="list-group" data-testid="workspaces-list">
                    @foreach (var ws in _workspaces)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between" data-testid="workspace-row">
                            <div>
                                <span class="fw-semibold">@ws.DisplayName</span>
                                <span class="text-secondary ms-2 small">@ws.Role</span>
                            </div>
                            @if (string.Equals(ws.TenantId, _tenantId, StringComparison.Ordinal))
                            {
                                <span class="badge bg-primary" data-testid="workspace-active-badge">Active</span>
                            }
                            else
                            {
                                <form method="post" action="/app/workspace">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="workspace" value="@ws.TenantId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary" data-testid="workspace-switch">Switch</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Members -->
    @if (_membershipsUnavailable)
    {
        <div class="card mt-3 mb-3" id="members">
            <div class="card-header"><h3 class="card-title">Members</h3></div>
            <div class="card-body">
                <div data-testid="members-operator-managed">
                    <p class="mb-0 text-secondary">This workspace is operator-managed; membership management isn't available here.</p>
                </div>
            </div>
        </div>
    }
    else if (ShowMembersSection)
    {
        <div class="card mt-3 mb-3" id="members">
            <div class="card-header"><h3 class="card-title">Members</h3></div>
            <div class="card-body">
                @if (MemberError is not null)
                {
                    <div class="alert alert-danger" role="alert" data-testid="members-action-error">@MemberError</div>
                }

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr><th>Member</th><th>Role</th><th class="w-1"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in ActiveMembers())
                            {
                                <tr data-testid="member-row">
                                    <td>@m.Email @(IsSelf(m) ? "(you)" : "")</td>
                                    <td><span class="badge bg-secondary-lt" data-testid="member-role">@m.Role</span></td>
                                    <td>
                                        @if (_isOwner)
                                        {
                                            <form method="post" action="/app/members/role" class="d-inline">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="membershipId" value="@m.MembershipId" />
                                                <input type="hidden" name="role" value="@Other(m.Role)" />
                                                <button type="submit" class="btn btn-sm btn-ghost-secondary" data-testid="member-role-toggle">Make @Other(m.Role)</button>
                                            </form>
                                            <form method="post" action="/app/members/remove" class="d-inline">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="membershipId" value="@m.MembershipId" />
                                                <button type="submit" class="btn btn-sm btn-ghost-danger" data-testid="member-remove">Remove</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_isOwner)
                {
                    @AddMemberForm
                }
                else
                {
                    <p class="text-secondary small mt-2" data-testid="members-readonly">Only Owners can add or manage members.</p>
                }
            </div>
        </div>
    }
    else if (ShowSoloInvite)
    {
        <!-- Single-workspace-first: a solo Owner gets an understated invite entry, not the full member-management section. -->
        <div class="card mt-3 mb-3" id="members">
            <div class="card-header"><h3 class="card-title">Members</h3></div>
            <div class="card-body">
                @if (MemberError is not null)
                {
                    <div class="alert alert-danger" role="alert" data-testid="members-action-error">@MemberError</div>
                }
                <p class="text-secondary mb-0" data-testid="members-solo">You're the only member of this workspace.</p>
                @AddMemberForm
            </div>
        </div>
    }

    <!-- Claim an existing workspace (tucked-away disclosure) -->
    <div class="card mt-3 mb-3" id="workspace-claim">
        <div class="card-body">
            @ClaimDisclosure
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    // No initializer (BL0008): the framework binds this on POST; on GET it stays null so OnInitialized seeds a fresh one.
    [SupplyParameterFromForm]
    public WorkspaceLinkInput Input { get; set; } = default!;

    // Set by the post-claim redirect (?linked=true) so a fresh GET can confirm the save that a redirect otherwise hides.
    [SupplyParameterFromQuery(Name = "linked")]
    public bool ShowClaimed { get; set; }

    // The self-service key forms (bound on POST; seeded fresh on GET — no initializer, BL0008).
    [SupplyParameterFromForm(FormName = "mint-key")]
    public MintKeyInput Mint { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rotate-key")]
    public KeyActionInput RotateForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "revoke-key")]
    public KeyActionInput RevokeForm { get; set; } = default!;

    // A member-management action's error, surfaced back on the PRG redirect from the member endpoints.
    [SupplyParameterFromQuery(Name = "memberError")]
    public string? MemberError { get; set; }

    // A free-workspace provision error, surfaced back on the PRG redirect from the provisioning endpoint.
    [SupplyParameterFromQuery(Name = "provisionError")]
    public string? ProvisionError { get; set; }

    // Which key (if any) a confirm card is being shown for, from the row action link (?rotate=/?revoke=<keyId>).
    [SupplyParameterFromQuery(Name = "rotate")]
    public string? RotateTarget { get; set; }

    [SupplyParameterFromQuery(Name = "revoke")]
    public string? RevokeTarget { get; set; }

    private bool _configured;          // console access configured on this deployment (Crawldad:ConsoleAuth)
    private bool _hasWorkspace;        // an active workspace resolved for this account
    private bool _workspaceUnavailable; // resolved a selection, but the console gate 403s it (removed/suspended) → the escape
    private string? _tenantId;         // the active workspace id — surfaced ONCE, in the copyable field
    private PortalTenant? _tenant;     // the resolved workspace client
    private TenantProfileResponse? _profile;
    private UsageResponse? _usage;
    private bool _usageError;
    private BillingConfigResponse? _billingConfig;
    private string? _error;

    // API keys section state.
    private IReadOnlyList<TenantApiKeyInfo> _keys = [];
    private bool _keysOperatorManaged; // env tenant — self-service unavailable (a 400 from GET /tenant/keys)
    private bool _keysError;           // the keys read failed for another reason (degrade cleanly, never a 500)
    private string? _mintedKey;        // the just-minted/rotated raw key, shown ONCE on this response, never persisted here
    private string? _mintedLabel;
    private string? _keysActionError;  // a mint/rotate/revoke failure surfaced in-place (incl. the last-key refusal)

    // Membership + members state. _myMembership is the signed-in user's own membership for this workspace; _members is this
    // workspace's member list. Env tenants have no membership surface (a 400 from GET /tenant/memberships).
    private TenantMembershipInfo? _myMembership;
    private bool _membershipsUnavailable;
    private IReadOnlyList<TenantMembershipInfo> _members = [];
    private bool _isOwner; // the signed-in user is an active Owner → the member-management controls render

    // The signed-in user's own workspaces (from GET /workspaces) — the switch list + the multi-workspace signal.
    private IReadOnlyList<WorkspaceSummary> _workspaces = [];

    private string? Email => HttpContext.User.FindFirstValue(ClaimTypes.Email);

    // The active workspace's DISPLAY NAME — its identity in the portal. Never the raw id (that lives only in the copyable
    // field). Falls back to a generic label if the profile read hasn't landed, so the id is never leaked as a heading.
    private string WorkspaceName => string.IsNullOrEmpty(_profile?.DisplayName) ? "Your workspace" : _profile!.DisplayName;

    // Single-workspace-first gates — all evaluated only in the resolved-workspace, membership-available markup branch, so
    // they don't re-check _hasWorkspace / _membershipsUnavailable (the markup already guards those). WorkspaceCount is the
    // multi-workspace signal; it falls back to 1 when the list read failed but a workspace is resolved (default to hiding the
    // switcher/team chrome). The switch list + the full member-management section appear only when there is more than one
    // workspace / member; a solo Owner instead gets the understated invite entry (ShowSoloInvite).
    private int WorkspaceCount => _workspaces.Count > 0 ? _workspaces.Count : 1;
    private bool IsMultiWorkspace => WorkspaceCount > 1;
    private bool ShowMembersSection => IsMultiWorkspace || ActiveMembers().Count > 1;
    private bool ShowSoloInvite => _isOwner && !ShowMembersSection;

    // The tier label, or a friendly default when the tenant has no configured tier. Called only where the profile is known
    // non-null (the header guard + the loaded-usage panel), so it takes the profile rather than reading a nullable.
    private static string PlanLabel(TenantProfileResponse profile) => profile.Tier ?? "Default";

    // The display name of the tenant's current tier from the billing catalog, or "Free" when none is marked current.
    private static string CurrentPlanLabel(BillingConfigResponse billing) =>
        billing.Tiers.FirstOrDefault(tier => tier.IsCurrent)?.DisplayName ?? "Free";

    protected override async Task OnInitializedAsync()
    {
        // No initializer on the form inputs (BL0008): the framework binds them on a POST; on a GET they are null. Static SSR
        // re-runs this for every request, so the current workspace + usage are resolved here for both the GET and the form-post
        // re-render — the submit handlers only redirect (on success) or set an error (on failure).
        Input ??= new();
        Mint ??= new();
        RotateForm ??= new();
        RevokeForm ??= new();
        _configured = Tenants.ConsoleConfigured;
        await LoadAsync();
    }

    private async Task HandleLinkAsync()
    {
        var email = Email;
        if (string.IsNullOrWhiteSpace(email))
        {
            // Defensive: an [Authorize] principal always carries the email claim, but never trust a null through.
            _error = "Your session has expired. Sign in again to claim a workspace.";
            return;
        }

        var result = await Linker.LinkAsync(email, Input.TenantId, Input.ApiKey, HttpContext.RequestAborted);
        if (result.Outcome == WorkspaceLinkOutcome.Claimed)
        {
            // Make the just-claimed workspace the active one, so the switcher and every data page land on it. Any other
            // workspaces stay reachable via their memberships.
            await Selections.SetAsync(email, Input.TenantId.Trim(), HttpContext.RequestAborted);

            // Post/Redirect/Get: a fresh GET re-resolves the now-active workspace and shows usage, and avoids a form re-post.
            // Static SSR issues the redirect by throwing NavigationException; control does not return past here.
            Nav.NavigateTo("/app/account?linked=true", forceLoad: true);
            return;
        }

        _error = result.Message;
    }

    // Resolves the current workspace (if any) and, when resolved, the live profile + usage + keys + members + workspaces.
    // Never throws for a no-workspace account (a clean empty state) nor for an API hiccup on a resolved one.
    private async Task LoadAsync()
    {
        var tenant = await Tenants.TryResolveAsync(HttpContext.RequestAborted);
        if (tenant is null)
        {
            _hasWorkspace = false;
            return;
        }

        _hasWorkspace = true;
        _tenant = tenant;
        _tenantId = tenant.TenantId;
        try
        {
            _profile = await tenant.Client.GetTenantAsync(HttpContext.RequestAborted);
            _usage = await tenant.Client.GetUsageAsync(HttpContext.RequestAborted);
        }
        catch (CrawldadException ex) when (ex.StatusCode == StatusCodes.Status403Forbidden)
        {
            // A stale/suspended active-workspace selection: the console gate 403s every read (including GET /workspaces, so
            // there is no in-page switch to offer). Show the honest "workspace unavailable" escape instead of a broken
            // has-workspace layout, and skip the rest — they would all 403 too. Never a 500.
            _workspaceUnavailable = true;
            return;
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            _usageError = true;
        }

        // Billing config is loaded independently of usage: a failure here degrades the billing card to a friendly
        // "not yet available" state without touching the usage panel (and a usage failure never hides the billing card).
        _billingConfig = await LoadBillingConfigAsync(tenant);

        // The workspace's own keys, for the API-keys section (independent of usage/billing state).
        await LoadKeysAsync(tenant);

        // The signed-in user's membership + this workspace's members, for the profile role + the members card.
        await LoadMembershipAsync(tenant);

        // The signed-in user's own workspaces, for the switch list + the multi-workspace signal.
        await LoadWorkspacesAsync(tenant);
    }

    // The signed-in user's active membership for this workspace, plus this workspace's full member list. Never throws: an env
    // tenant is a clean "operator-managed" state (400), and any other API hiccup simply leaves the rows empty.
    private async Task LoadMembershipAsync(PortalTenant tenant)
    {
        try
        {
            var normalized = Crawldad.Contracts.EmailAddress.Normalize(Email ?? "");
            var response = await tenant.Client.ListMembershipsAsync(HttpContext.RequestAborted);
            _members = response.Memberships ?? []; // defensive: a malformed body never crashes the account page
            _myMembership = _members.FirstOrDefault(
                membership => membership.Active && string.Equals(membership.Email, normalized, StringComparison.Ordinal));
            _isOwner = _myMembership is { Active: true, Role: MembershipRole.Owner }; // gates the member-management controls
        }
        catch (CrawldadApiException ex) when (ex.StatusCode == StatusCodes.Status400BadRequest)
        {
            _membershipsUnavailable = true; // an env-configured tenant has no membership surface
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            // Degrade cleanly — the rows stay empty rather than crashing the account page.
        }
    }

    // The signed-in user's own workspaces (GET /workspaces) for the switch list + the multi-workspace signal. Best-effort:
    // a failure leaves the list empty, so the account defaults to single-workspace-first (no switcher chrome).
    private async Task LoadWorkspacesAsync(PortalTenant tenant)
    {
        try
        {
            _workspaces = (await tenant.Client.ListMyWorkspacesAsync(HttpContext.RequestAborted)).Workspaces ?? [];
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            // Best-effort — the switcher degrades to hidden.
        }
    }

    // The tenant's billing config, or null when the provider call fails — which the billing card renders as the friendly
    // "not yet available" state rather than a crash.
    private async Task<BillingConfigResponse?> LoadBillingConfigAsync(PortalTenant tenant)
    {
        try
        {
            return await tenant.Client.GetBillingConfigAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            return null;
        }
    }

    // Percentage (0..100) of value against a cap, guarding a zero/absent allowance.
    private static int Pct(long value, long max) => max <= 0 ? 0 : (int)Math.Min(100, Math.Round(100.0 * value / max));

    // A queue wait in ms as a compact human string: seconds under a minute, else minutes + seconds.
    private static string FormatWait(long ms)
    {
        var seconds = ms / 1000.0;
        return seconds < 60
            ? $"{seconds:0.0}s"
            : $"{(int)(seconds / 60)}m {(int)Math.Round(seconds % 60)}s";
    }

    // ---- API keys ------------------------------------------------------------------------------------------------

    // The workspace's keys, or the operator-managed / error state — never a throw (the section degrades cleanly).
    private async Task LoadKeysAsync(PortalTenant tenant)
    {
        try
        {
            _keys = (await tenant.Client.ListTenantKeysAsync(HttpContext.RequestAborted)).Keys;
        }
        catch (CrawldadApiException ex) when (ex.StatusCode == StatusCodes.Status400BadRequest)
        {
            _keysOperatorManaged = true; // env tenant — its keys are operator config (self_service_unavailable)
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            _keysError = true;
        }
    }

    // Mints a key and shows its raw value ONCE — no redirect, so the one-time secret is on this response body only and is
    // never persisted by the portal nor visible on a later GET. The portal authenticates via console, so a new key never
    // affects this session — the list simply re-reads.
    private async Task MintKeyAsync()
    {
        var tenant = _tenant!; // the mint form renders only with a resolved workspace
        try
        {
            ShowMinted(await tenant.Client.MintTenantKeyAsync(Mint.Label, HttpContext.RequestAborted));
            await LoadKeysAsync(tenant);
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message; // e.g. a too-long label (validation) or an Owner-only refusal
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
        }

        Mint = new(); // clear the label input on the re-render
    }

    // Rotates a key: mints a replacement (shown once) and revokes the old one. The portal authenticates via console, not any
    // tenant key, so rotating never affects this session — the list re-reads cleanly through the console client.
    private async Task RotateKeyAsync()
    {
        var tenant = _tenant!;
        try
        {
            ShowMinted(await tenant.Client.RotateTenantKeyAsync(RotateForm.KeyId, HttpContext.RequestAborted));
            await LoadKeysAsync(tenant);
        }
        catch (CrawldadNotFoundException)
        {
            _keysActionError = "That key no longer exists — it may have already been rotated or revoked.";
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
        }
    }

    // Revokes a key, then redirects (PRG) so the fresh list reflects it. A refusal (the last-key guard for a workspace with
    // no console recovery) or another error is surfaced in place; an already-gone key (404) is treated as done.
    private async Task RevokeKeyAsync()
    {
        var tenant = _tenant!;
        try
        {
            await tenant.Client.RevokeTenantKeyAsync(RevokeForm.KeyId, HttpContext.RequestAborted);
        }
        catch (CrawldadNotFoundException)
        {
            // Already gone — treat as done and let the redirect refresh the list.
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message; // the 409 last-key refusal, surfaced with its rotate guidance
            return;
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
            return;
        }

        Nav.NavigateTo("/app/account", forceLoad: true);
    }

    private void ShowMinted(TenantApiKeyCreated created)
    {
        _mintedKey = created.ApiKey;
        _mintedLabel = created.Label;
    }

    // The key the ?revoke= row action points at (by id), or null — the confirm card renders for it; the API backstops a
    // crafted id (a revoked key is a 404 on submit).
    private TenantApiKeyInfo? RevokeConfirmTarget() =>
        Guid.TryParse(RevokeTarget, out var id) ? _keys.FirstOrDefault(key => key.KeyId == id) : null;

    // The key the ?rotate= row action points at (by id), or null.
    private TenantApiKeyInfo? RotateConfirmTarget() =>
        Guid.TryParse(RotateTarget, out var id) ? _keys.FirstOrDefault(key => key.KeyId == id) : null;

    // Whether the workspace has exactly one active key left — the confirm copy notes the console recovery path.
    private bool IsLastActiveKey() => _keys.Count(key => key.Active) <= 1;

    // A UTC timestamp as a compact, stable string for a key's created / last-used columns.
    private static string FormatUtc(DateTimeOffset when) =>
        when.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);

    // This workspace's active members (the listing already orders newest first).
    private IReadOnlyList<TenantMembershipInfo> ActiveMembers() => [.. _members.Where(m => m.Active)];

    // Whether a member row is the signed-in user (so it can be marked "you").
    private bool IsSelf(TenantMembershipInfo member) =>
        string.Equals(member.Email, Crawldad.Contracts.EmailAddress.Normalize(Email ?? ""), StringComparison.Ordinal);

    // The role a "make X" toggle switches to — the opposite of the member's current role.
    private static MembershipRole Other(MembershipRole role) =>
        role == MembershipRole.Owner ? MembershipRole.Member : MembershipRole.Owner;

    /// <summary>The optional label for a minted key.</summary>
    public sealed class MintKeyInput
    {
        /// <summary>An optional display label for the new key.</summary>
        public string? Label { get; set; }
    }

    /// <summary>The key a rotate/revoke form targets (its id rides in a hidden field).</summary>
    public sealed class KeyActionInput
    {
        /// <summary>The key record id to act on.</summary>
        public Guid KeyId { get; set; }
    }
}
