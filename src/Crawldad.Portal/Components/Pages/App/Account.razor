@page "/app/account"
@layout AppLayout
@attribute [Authorize]
@using System.Globalization
@using System.Security.Cryptography
@using Crawldad.Client
@using Crawldad.Contracts.Billing
@using Crawldad.Contracts.Tenancy
@using Crawldad.Portal.Tenancy
@inject IPortalTenantContext Tenants
@inject IWorkspaceLinker Linker
@inject NavigationManager Nav

<PageTitle>Account &amp; usage · Crawldad</PageTitle>

@*
    The account area (issue #119 P4). Static SSR — the workspace-link form handler runs on the real HTTP POST so it can
    validate the submitted key against the live API and persist through IPortalTenantLinkStore before the response is
    sent. Sections: profile, workspace link, plan & usage (from GET /tenant + GET /usage via the tenant client),
    billing (Stripe Checkout + billing portal, from the billing-config read), and API keys (operator-managed for now).
    Never a 500 when unlinked; the API key is treated
    like a password — posted, validated, stored encrypted, and never echoed back or logged.
*@
<div class="page-header">
    <h1 class="page-title">Account &amp; usage</h1>
</div>

@if (ShowLinked)
{
    <div class="alert alert-success mt-3" role="status" data-testid="link-success">
        <div class="d-flex">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
            </div>
            <div>Workspace linked. Your plan and usage are shown below.</div>
        </div>
    </div>
}

<!-- Profile -->
<div class="card mt-3" id="profile">
    <div class="card-header"><h3 class="card-title">Profile</h3></div>
    <div class="card-body">
        <dl class="account-kv mb-0">
            <dt>Signed in as</dt>
            <dd data-testid="account-email">@Email</dd>

            <dt>Workspace</dt>
            <dd>
                @if (_relinkNeeded)
                {
                    <span class="status status-yellow" data-testid="link-status">
                        <span class="status-dot"></span>Re-link required
                    </span>
                }
                else if (_linked)
                {
                    <span class="status status-green" data-testid="link-status">
                        <span class="status-dot"></span>Linked to <span class="fw-semibold ms-1">@_tenantId</span>
                    </span>
                }
                else
                {
                    <span class="status status-secondary" data-testid="link-status">
                        <span class="status-dot"></span>Not linked
                    </span>
                }
            </dd>

            @if (_tenant is not null)
            {
                <dt>Console access</dt>
                <dd>
                    @if (_tenant.AuthMode == PortalAuthMode.Console)
                    {
                        <span class="status status-green" data-testid="console-mode">
                            <span class="status-dot"></span>Console
                        </span>
                    }
                    else
                    {
                        <span class="status status-secondary" data-testid="console-mode">
                            <span class="status-dot"></span>Stored key
                        </span>
                    }
                    @if (_membershipsUnavailable)
                    {
                        <span class="text-secondary ms-2" data-testid="membership-status">Operator-managed workspace</span>
                    }
                    else if (_myMembership is not null)
                    {
                        <span class="ms-2" data-testid="membership-status">@_myMembership.Role.ToString() membership</span>
                    }
                    else
                    {
                        <span class="text-secondary ms-2" data-testid="membership-status">No membership</span>
                    }
                </dd>
            }

            <dt>Session</dt>
            <dd>
                @* Reuse the existing sign-out endpoint (same antiforgery-protected POST the shell header uses). *@
                <form method="post" action="/auth/signout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" data-testid="account-sign-out">Sign out</button>
                </form>
            </dd>
        </dl>
    </div>
</div>

<!-- Workspace link -->
<div class="card mt-3" id="workspace-link">
    <div class="card-header">
        <h3 class="card-title">@(_linked ? "Update workspace link" : "Link your workspace")</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary">
            Paste your Crawldad workspace ID and a tenant API key. We verify the key against the API before saving it —
            it is stored encrypted at rest and never shown again.
        </p>

        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert" data-testid="link-error">@_error</div>
        }

        <EditForm id="link-form" Model="Input" FormName="workspace-link" OnValidSubmit="HandleLinkAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="tenantId">Workspace ID</label>
                    <InputText id="tenantId" class="form-control" autocomplete="off" spellcheck="false" @bind-Value="Input.TenantId" />
                    <ValidationMessage For="() => Input.TenantId" />
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="apiKey">API key</label>
                    @* Manual input with no value attribute: the secret binds IN on POST but is never rendered back OUT. *@
                    <input id="apiKey" name="Input.ApiKey" type="password" class="form-control" autocomplete="off" spellcheck="false" placeholder="Paste your API key" />
                    <ValidationMessage For="() => Input.ApiKey" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary" data-testid="link-submit">
                    @(_linked ? "Re-verify & update" : "Verify & link")
                </button>
            </div>
        </EditForm>
    </div>
</div>

<!-- Plan & usage -->
<div class="card mt-3" id="usage">
    <div class="card-header">
        <h3 class="card-title">Plan &amp; usage</h3>
        @if (_linked && _profile is not null)
        {
            <div class="card-actions text-secondary small">@PlanLabel(_profile) · live</div>
        }
    </div>
    <div class="card-body">
        @if (_relinkNeeded)
        {
            <div class="empty" data-testid="usage-relink">
                <p class="empty-title">Your saved key can't be read</p>
                <p class="empty-subtitle text-secondary">
                    We couldn't decrypt your stored API key (the portal's encryption key was rotated). Re-link your
                    workspace above with a current key to restore access — your data is safe.
                </p>
                <div class="empty-action">
                    <a href="#workspace-link" class="btn btn-primary">Re-link your workspace</a>
                </div>
            </div>
        }
        else if (!_linked)
        {
            <div class="empty" data-testid="usage-unlinked">
                <p class="empty-title">No usage yet</p>
                <p class="empty-subtitle text-secondary">
                    Link your workspace above to see live slot occupancy, queue depth, and your guardrails.
                </p>
                <div class="empty-action">
                    <a href="#workspace-link" class="btn btn-primary">Link your workspace</a>
                </div>
            </div>
        }
        else if (_usageError)
        {
            <div class="empty" data-testid="usage-error">
                <p class="empty-title">Usage is unavailable right now</p>
                <p class="empty-subtitle text-secondary">
                    We couldn't read your usage from the API. Your link is saved — try again shortly, or re-verify your
                    key above if it was rotated.
                </p>
            </div>
        }
        else
        {
            // Reached only when linked with no load error, so both are set — capture non-null locals for the panel.
            var usage = _usage!;
            var profile = _profile!;
            <div class="row g-3" data-testid="usage-panel">
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">Slots in use</div>
                        <div class="kpi" data-testid="usage-slots">@usage.Slots.InUse <span class="kpi-of">/ @usage.Slots.Allowance</span></div>
                        <div class="meter mt-2"><span style="width:@(Pct(usage.Slots.InUse, usage.Slots.Allowance))%"></span></div>
                        <div class="text-secondary kpi-note">Concurrent runs admitted right now.</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">Queue depth</div>
                        <div class="kpi" data-testid="usage-queue">@usage.Queue.Depth <span class="kpi-of">/ @profile.QueueDepthAllowance</span></div>
                        <div class="meter mt-2"><span style="width:@(Pct(usage.Queue.Depth, profile.QueueDepthAllowance))%"></span></div>
                        <div class="text-secondary kpi-note">Runs wait here at the slot cap — no 429 until it fills.</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">p95 queue wait</div>
                        <div class="kpi" data-testid="usage-p95">@FormatWait(usage.Queue.P95WaitMs)</div>
                        <div class="text-secondary kpi-note">Across @usage.Queue.Sampled promoted run(s). Sustained wait is the "add slots" signal.</div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="fw-semibold mb-3">Guardrails <span class="text-secondary fw-normal small">— headroom before the hard ceilings</span></div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="small">Events / run (peak)</span>
                            <span class="mono small" data-testid="usage-events">@usage.Events.Max <span class="text-secondary">/ @usage.Events.Guardrail</span></span>
                        </div>
                        <div class="meter"><span style="width:@(Pct(usage.Events.Max, usage.Events.Guardrail))%"></span></div>
                        <div class="text-secondary kpi-note">Peak over the last @usage.Events.Sampled run(s) · avg @usage.Events.Avg.</div>
                    </div>
                    <div class="datacard">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="small">Runs started this month</span>
                            <span class="kpi-inline mono" data-testid="usage-runs">@usage.RunsStartedThisMonth</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="fw-semibold mb-3">Plan</div>
                    <dl class="account-kv">
                        <dt>Tier</dt>
                        <dd data-testid="plan-tier">@PlanLabel(profile)</dd>
                        <dt>Concurrent slots</dt>
                        <dd>@profile.SlotAllowance</dd>
                        <dt>Queue depth</dt>
                        <dd>@profile.QueueDepthAllowance</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

<!-- Billing -->
<div class="card mt-3" id="billing">
    <div class="card-header"><h3 class="card-title">Billing</h3></div>
    <div class="card-body">
        @if (!_linked || _relinkNeeded)
        {
            <div class="empty" data-testid="billing-unlinked">
                <p class="empty-title">Link your workspace to manage billing</p>
                <p class="empty-subtitle text-secondary">
                    Once your workspace is linked, upgrade your plan or open the billing portal from here.
                </p>
            </div>
        }
        else if (_billingConfig is not { Configured: true } billing)
        {
            <div class="empty" data-testid="billing-unavailable">
                <p class="empty-title">Billing not yet available</p>
                <p class="empty-subtitle text-secondary">
                    Plan changes, invoices, and payment method will open in Stripe. Nothing to do here yet.
                </p>
            </div>
        }
        else
        {
            <div data-testid="billing-panel">
                <p class="text-secondary">
                    Your plan is <span class="fw-semibold" data-testid="billing-current">@CurrentPlanLabel(billing)</span>.
                    Upgrading opens Stripe Checkout; "Manage billing" opens the Stripe billing portal. Your plan changes
                    only after checkout completes.
                </p>
                <div class="row g-3">
                    @foreach (var tier in billing.Tiers)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <div class="datacard h-100 @(tier.IsCurrent ? "border-primary" : "")">
                                <div class="fw-semibold">@tier.DisplayName</div>
                                <div class="kpi-inline">@tier.PriceLabel</div>
                                @if (tier.Slots is int slots)
                                {
                                    <div class="text-secondary small">@slots concurrent slots</div>
                                }
                                <div class="mt-2">
                                    @if (tier.IsCurrent)
                                    {
                                        <span class="badge bg-primary" data-testid="billing-tier-current">Current plan</span>
                                    }
                                    else if (tier.SelfServe)
                                    {
                                        <form method="post" action="/app/billing/checkout">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="tier" value="@tier.Tier" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm" data-testid="billing-upgrade-@tier.Tier">
                                                Choose @tier.DisplayName
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">Contact sales</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <form method="post" action="/app/billing/portal">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-primary" data-testid="billing-manage">Manage billing</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- API keys -->
<div class="card mt-3 mb-3" id="apikeys">
    <div class="card-header"><h3 class="card-title">API keys</h3></div>
    <div class="card-body">
        @if (!_linked || _relinkNeeded)
        {
            <div class="empty" data-testid="keys-unlinked">
                <p class="empty-title">Link your workspace to manage keys</p>
                <p class="empty-subtitle text-secondary">
                    Once your workspace is linked, mint, rotate, and revoke its API keys here.
                </p>
            </div>
        }
        else if (_keysOperatorManaged)
        {
            <div data-testid="keys-operator-managed">
                <p class="mb-1">This workspace's API keys are managed by the Crawldad operator.</p>
                <p class="text-secondary mb-0 small">
                    Self-service key management isn't available for this workspace. For your security, key material is
                    never displayed here.
                </p>
            </div>
        }
        else if (_keysError)
        {
            <div class="empty" data-testid="keys-error">
                <p class="empty-title">Keys are unavailable right now</p>
                <p class="empty-subtitle text-secondary">We couldn't read your keys from the API. Try again shortly.</p>
            </div>
        }
        else
        {
            @if (_mintedKey is not null)
            {
                <div class="alert alert-success" role="status" data-testid="minted-key">
                    <div class="fw-semibold mb-1">New API key@(_mintedLabel is null ? "" : $" ({_mintedLabel})") — copy it now</div>
                    <p class="text-secondary small mb-2">
                        This is the only time the full key is shown. Store it somewhere safe — you can't see it again.
                    </p>
                    <div class="input-group">
                        @* Show-once: rendered on THIS response only, never persisted by the portal and never in a later GET. *@
                        <input id="minted-key" class="form-control cd-mono" readonly value="@_mintedKey" onclick="this.select()" data-testid="minted-key-value" />
                        <button type="button" class="btn btn-outline-primary" data-testid="minted-key-copy"
                                onclick="navigator.clipboard.writeText(document.getElementById('minted-key').value);this.textContent='Copied';">Copy</button>
                    </div>
                </div>
            }

            @if (_keysActionError is not null)
            {
                <div class="alert alert-danger" role="alert" data-testid="keys-action-error">@_keysActionError</div>
            }

            @if (RevokeConfirmTarget() is { } toRevoke)
            {
                <div class="card mb-3 border-danger" data-testid="revoke-confirm">
                    <div class="card-body">
                        <h3 class="mb-1">Revoke key @toRevoke.Prefix…?</h3>
                        <p class="text-secondary">Any client using this key stops working immediately. This can't be undone.</p>
                        <EditForm FormName="revoke-key" Model="RevokeForm" OnValidSubmit="RevokeKeyAsync" data-testid="revoke-form">
                            <input type="hidden" name="RevokeForm.KeyId" value="@toRevoke.KeyId" />
                            <button type="submit" class="btn btn-danger" data-testid="revoke-submit">Revoke key</button>
                            <a href="/app/account" class="btn btn-link">Cancel</a>
                        </EditForm>
                    </div>
                </div>
            }

            @if (RotateConfirmTarget() is { } toRotate)
            {
                <div class="card mb-3 border-warning" data-testid="rotate-confirm">
                    <div class="card-body">
                        <h3 class="mb-1">Rotate key @toRotate.Prefix…?</h3>
                        <p class="text-secondary">
                            A new key is minted and this one is revoked immediately.
                            @(toRotate.Current
                                ? "This is the key this session uses — the portal switches to the new key automatically."
                                : "Any client using the old key must switch to the new one.")
                        </p>
                        <EditForm FormName="rotate-key" Model="RotateForm" OnValidSubmit="RotateKeyAsync" data-testid="rotate-form">
                            <input type="hidden" name="RotateForm.KeyId" value="@toRotate.KeyId" />
                            <button type="submit" class="btn btn-warning" data-testid="rotate-submit">Rotate key</button>
                            <a href="/app/account" class="btn btn-link">Cancel</a>
                        </EditForm>
                    </div>
                </div>
            }

            @if (_keyListStale)
            {
                <div class="empty" data-testid="keys-stale">
                    <p class="empty-title">Session key rotated</p>
                    <p class="empty-subtitle text-secondary">The portal is now using your new key. Refresh to see the updated key list.</p>
                    <div class="empty-action"><a href="/app/account" class="btn btn-primary">Refresh</a></div>
                </div>
            }
            else if (_keys.Count == 0)
            {
                <p class="text-secondary" data-testid="keys-empty">No keys yet — mint one below.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr><th>Key</th><th>Label</th><th>Created</th><th>Last used</th><th>Status</th><th class="w-1"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var key in _keys)
                            {
                                <tr data-testid="key-row">
                                    <td class="cd-mono">@key.Prefix…</td>
                                    <td>@(key.Label ?? "—")</td>
                                    <td class="text-secondary">@FormatUtc(key.CreatedAt)</td>
                                    <td class="text-secondary">@(key.LastUsedAt is { } used ? FormatUtc(used) : "—")</td>
                                    <td>
                                        @if (!key.Active)
                                        {
                                            <span class="badge bg-secondary-lt" data-testid="key-status-revoked">Revoked</span>
                                        }
                                        else if (key.Current)
                                        {
                                            <span class="badge bg-green-lt" data-testid="key-status-current">Active · this session</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-green-lt" data-testid="key-status-active">Active</span>
                                        }
                                    </td>
                                    <td>
                                        @if (key.Active)
                                        {
                                            <a href="@($"/app/account?rotate={key.KeyId}#apikeys")" class="btn btn-sm btn-ghost-secondary" data-testid="rotate-link">Rotate</a>
                                            @if (!key.Current)
                                            {
                                                <a href="@($"/app/account?revoke={key.KeyId}#apikeys")" class="btn btn-sm btn-ghost-danger" data-testid="revoke-link">Revoke</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr class="my-3" />
            <div class="fw-semibold mb-2">Mint a new key</div>
            <p class="text-secondary small">
                Use keys to authenticate the API and the SDK. Rotating or revoking the key this session uses is guarded —
                rotate replaces it without a gap.
            </p>
            <EditForm FormName="mint-key" Model="Mint" OnValidSubmit="MintKeyAsync" data-testid="mint-form">
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label" for="key-label">Label <span class="text-secondary fw-normal">(optional)</span></label>
                        <InputText id="key-label" class="form-control" autocomplete="off" spellcheck="false" placeholder="e.g. ci, laptop, mcp-agent" @bind-Value="Mint.Label" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100" data-testid="mint-submit">Mint key</button>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    // No initializer (BL0008): the framework binds this on POST; on GET it stays null so OnInitialized seeds a fresh one.
    [SupplyParameterFromForm]
    public WorkspaceLinkInput Input { get; set; } = default!;

    // Set by the post-link redirect (?linked=true) so a fresh GET can confirm the save that a redirect otherwise hides.
    [SupplyParameterFromQuery(Name = "linked")]
    public bool ShowLinked { get; set; }

    // The self-service key forms (bound on POST; seeded fresh on GET — no initializer, BL0008).
    [SupplyParameterFromForm(FormName = "mint-key")]
    public MintKeyInput Mint { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rotate-key")]
    public KeyActionInput RotateForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "revoke-key")]
    public KeyActionInput RevokeForm { get; set; } = default!;

    // Which key (if any) a confirm card is being shown for, from the row action link (?rotate=/?revoke=<keyId>).
    [SupplyParameterFromQuery(Name = "rotate")]
    public string? RotateTarget { get; set; }

    [SupplyParameterFromQuery(Name = "revoke")]
    public string? RevokeTarget { get; set; }

    private bool _linked;
    private bool _relinkNeeded;
    private string? _tenantId;
    private TenantProfileResponse? _profile;
    private UsageResponse? _usage;
    private bool _usageError;
    private BillingConfigResponse? _billingConfig;
    private string? _error;

    // API keys section state.
    private PortalTenant? _tenant;     // the resolved tenant from LoadAsync; the key forms render only when this is set
    private IReadOnlyList<TenantApiKeyInfo> _keys = [];
    private bool _keysOperatorManaged; // env tenant — self-service unavailable (a 400 from GET /tenant/keys)
    private bool _keysError;           // the keys read failed for another reason (degrade cleanly, never a 500)
    private string? _mintedKey;        // the just-minted/rotated raw key, shown ONCE on this response, never persisted here
    private string? _mintedLabel;
    private string? _keysActionError;  // a mint/rotate/revoke failure surfaced in-place (incl. the last/current-key refusal)
    private bool _keyListStale;        // set after rotating the session key: the old client can't re-list, so prompt a refresh

    // Console membership section state (issue #119 PR4): the signed-in user's own membership for this tenant, shown
    // alongside the link + console-mode state. Env tenants have no membership surface (a 400 from GET /tenant/memberships).
    private TenantMembershipInfo? _myMembership;
    private bool _membershipsUnavailable;

    private string? Email => HttpContext.User.FindFirstValue(ClaimTypes.Email);

    // The tier label, or a friendly default when the tenant has no configured tier. Called only where the profile is
    // known non-null (the header guard + the loaded-usage panel), so it takes the profile rather than reading a nullable.
    private static string PlanLabel(TenantProfileResponse profile) => profile.Tier ?? "Default";

    // The display name of the tenant's current tier from the billing catalog, or "Free" when none is marked current.
    private static string CurrentPlanLabel(BillingConfigResponse billing) =>
        billing.Tiers.FirstOrDefault(tier => tier.IsCurrent)?.DisplayName ?? "Free";

    protected override async Task OnInitializedAsync()
    {
        // No initializer on Input (BL0008): the framework binds it on a POST; on a GET it is null. Static SSR re-runs
        // this for every request, so the current link + usage are resolved here for both the GET and the form-post
        // re-render — the submit handler only redirects (on success) or sets an error (on failure).
        Input ??= new();
        Mint ??= new();
        RotateForm ??= new();
        RevokeForm ??= new();
        await LoadAsync();
    }

    private async Task HandleLinkAsync()
    {
        var email = Email;
        if (string.IsNullOrWhiteSpace(email))
        {
            // Defensive: an [Authorize] principal always carries the email claim, but never trust a null into the store.
            _error = "Your session has expired. Sign in again to link a workspace.";
            return;
        }

        var result = await Linker.LinkAsync(email, Input.TenantId, Input.ApiKey, HttpContext.RequestAborted);
        if (result.Outcome == WorkspaceLinkOutcome.Linked)
        {
            // Post/Redirect/Get: a fresh GET re-resolves the now-linked tenant and shows usage, and avoids a form
            // re-post. Static SSR issues the redirect by throwing NavigationException; control does not return past here.
            Nav.NavigateTo("/app/account?linked=true", forceLoad: true);
            return;
        }

        _error = result.Message;
    }

    // Resolves the current link (if any) and, when linked, the live tenant profile + usage. Never throws for an
    // unlinked account (a clean not-linked state) nor for an API hiccup on a linked account (a friendly usage-error).
    private async Task LoadAsync()
    {
        PortalTenant? tenant;
        try
        {
            tenant = await Tenants.TryResolveAsync(HttpContext.RequestAborted);
        }
        catch (CryptographicException)
        {
            // The account IS linked, but its stored key can't be decrypted (the Data-Protection ring was rotated or
            // lost). That is a "re-link needed" prompt, never a 500 — the raw key is unrecoverable, so ask for a new one.
            _relinkNeeded = true;
            return;
        }

        if (tenant is null)
        {
            _linked = false;
            return;
        }

        _linked = true;
        _tenant = tenant;
        _tenantId = tenant.TenantId;
        try
        {
            _profile = await tenant.Client.GetTenantAsync(HttpContext.RequestAborted);
            _usage = await tenant.Client.GetUsageAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            _usageError = true;
        }

        // Billing config is loaded independently of usage: a failure here degrades the billing card to a friendly
        // "not yet available" state without touching the usage panel (and a usage failure never hides the billing card).
        _billingConfig = await LoadBillingConfigAsync(tenant);

        // The tenant's own keys, for the API-keys section (independent of usage/billing state).
        await LoadKeysAsync(tenant);

        // The signed-in user's console membership, for the console-access row (independent of everything above).
        await LoadMembershipAsync(tenant);
    }

    // The signed-in user's active membership for this tenant, or null. Never throws: an env tenant is a clean
    // "operator-managed" state (400), and any other API hiccup simply leaves the row showing "no membership".
    private async Task LoadMembershipAsync(PortalTenant tenant)
    {
        try
        {
            var normalized = Crawldad.Contracts.EmailAddress.Normalize(Email ?? "");
            var response = await tenant.Client.ListMembershipsAsync(HttpContext.RequestAborted);
            var memberships = response.Memberships ?? []; // defensive: a malformed body never crashes the account page
            _myMembership = memberships.FirstOrDefault(
                membership => membership.Active && string.Equals(membership.Email, normalized, StringComparison.Ordinal));
        }
        catch (CrawldadApiException ex) when (ex.StatusCode == StatusCodes.Status400BadRequest)
        {
            _membershipsUnavailable = true; // an env-configured tenant has no membership surface
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            // Degrade cleanly — the row shows "no membership" rather than crashing the account page.
        }
    }

    // The tenant's billing config, or null when the provider call fails — which the billing card renders as the friendly
    // "not yet available" state rather than a crash.
    private async Task<BillingConfigResponse?> LoadBillingConfigAsync(PortalTenant tenant)
    {
        try
        {
            return await tenant.Client.GetBillingConfigAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            return null;
        }
    }

    // Percentage (0..100) of value against a cap, guarding a zero/absent allowance.
    private static int Pct(long value, long max) => max <= 0 ? 0 : (int)Math.Min(100, Math.Round(100.0 * value / max));

    // A queue wait in ms as a compact human string: seconds under a minute, else minutes + seconds.
    private static string FormatWait(long ms)
    {
        var seconds = ms / 1000.0;
        return seconds < 60
            ? $"{seconds:0.0}s"
            : $"{(int)(seconds / 60)}m {(int)Math.Round(seconds % 60)}s";
    }

    // ---- API keys ------------------------------------------------------------------------------------------------

    // The authenticated tenant's keys, or the operator-managed / error state — never a throw (the section degrades cleanly).
    private async Task LoadKeysAsync(PortalTenant tenant)
    {
        try
        {
            _keys = (await tenant.Client.ListTenantKeysAsync(HttpContext.RequestAborted)).Keys;
        }
        catch (CrawldadApiException ex) when (ex.StatusCode == StatusCodes.Status400BadRequest)
        {
            _keysOperatorManaged = true; // env tenant — its keys are operator config (self_service_unavailable)
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            _keysError = true;
        }
    }

    // Mints a key and shows its raw value ONCE — no redirect, so the one-time secret is on this response body only and is
    // never persisted by the portal nor visible on a later GET.
    private async Task MintKeyAsync()
    {
        var tenant = _tenant!; // the mint form renders only when linked, so the tenant is resolved
        try
        {
            ShowMinted(await tenant.Client.MintTenantKeyAsync(Mint.Label, HttpContext.RequestAborted));
            await LoadKeysAsync(tenant); // the session key is unchanged, so the list re-reads cleanly
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message; // e.g. a too-long label (validation)
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
        }

        Mint = new(); // clear the label input on the re-render
    }

    // Rotates a key: mints a replacement (shown once) and revokes the old one. Rotating the SESSION key re-links the portal
    // to the replacement so it keeps working; the old client then can't re-list, so the list is marked stale for a refresh.
    private async Task RotateKeyAsync()
    {
        var tenant = _tenant!;
        var wasCurrent = _keys.Any(key => key.KeyId == RotateForm.KeyId && key.Current);
        try
        {
            var created = await tenant.Client.RotateTenantKeyAsync(RotateForm.KeyId, HttpContext.RequestAborted);
            ShowMinted(created);

            if (wasCurrent)
            {
                // The portal was authenticating with the key we just rotated out; persist the replacement so it keeps
                // working (email is guaranteed by [Authorize]). The revoked client can't re-list — prompt a refresh instead.
                await Linker.LinkAsync(Email!, tenant.TenantId, created.ApiKey, HttpContext.RequestAborted);
                _keyListStale = true;
            }
            else
            {
                await LoadKeysAsync(tenant);
            }
        }
        catch (CrawldadNotFoundException)
        {
            _keysActionError = "That key no longer exists — it may have already been rotated or revoked.";
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
        }
    }

    // Revokes a key, then redirects (PRG) so the fresh list reflects it. A refusal (the last/current-key guard) or another
    // error is surfaced in place; an already-gone key (404) is treated as done.
    private async Task RevokeKeyAsync()
    {
        var tenant = _tenant!;
        try
        {
            await tenant.Client.RevokeTenantKeyAsync(RevokeForm.KeyId, HttpContext.RequestAborted);
        }
        catch (CrawldadNotFoundException)
        {
            // Already gone — treat as done and let the redirect refresh the list.
        }
        catch (CrawldadException ex)
        {
            _keysActionError = ex.Message; // the 409 last/current-key refusal, surfaced with its rotate guidance
            return;
        }
        catch (HttpRequestException)
        {
            _keysActionError = "Couldn't reach the API. Try again shortly.";
            return;
        }

        Nav.NavigateTo("/app/account", forceLoad: true);
    }

    private void ShowMinted(TenantApiKeyCreated created)
    {
        _mintedKey = created.ApiKey;
        _mintedLabel = created.Label;
    }

    // The key the ?revoke= row action points at (by id), or null — the confirm card renders for it; the API backstops a
    // crafted id (a revoked/current key is a 404 / a 409 on submit).
    private TenantApiKeyInfo? RevokeConfirmTarget() =>
        Guid.TryParse(RevokeTarget, out var id) ? _keys.FirstOrDefault(key => key.KeyId == id) : null;

    // The key the ?rotate= row action points at (by id), or null.
    private TenantApiKeyInfo? RotateConfirmTarget() =>
        Guid.TryParse(RotateTarget, out var id) ? _keys.FirstOrDefault(key => key.KeyId == id) : null;

    // A UTC timestamp as a compact, stable string for a key's created / last-used columns.
    private static string FormatUtc(DateTimeOffset when) =>
        when.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);

    /// <summary>The optional label for a minted key.</summary>
    public sealed class MintKeyInput
    {
        /// <summary>An optional display label for the new key.</summary>
        public string? Label { get; set; }
    }

    /// <summary>The key a rotate/revoke form targets (its id rides in a hidden field).</summary>
    public sealed class KeyActionInput
    {
        /// <summary>The key record id to act on.</summary>
        public Guid KeyId { get; set; }
    }
}
