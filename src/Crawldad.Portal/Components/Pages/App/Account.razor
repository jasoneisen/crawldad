@page "/app/account"
@layout AppLayout
@attribute [Authorize]
@using System.Security.Cryptography
@using Crawldad.Client
@using Crawldad.Contracts.Billing
@using Crawldad.Contracts.Tenancy
@using Crawldad.Portal.Tenancy
@inject IPortalTenantContext Tenants
@inject IWorkspaceLinker Linker
@inject NavigationManager Nav

<PageTitle>Account &amp; usage · Crawldad</PageTitle>

@*
    The account area (issue #119 P4). Static SSR — the workspace-link form handler runs on the real HTTP POST so it can
    validate the submitted key against the live API and persist through IPortalTenantLinkStore before the response is
    sent. Sections: profile, workspace link, plan & usage (from GET /tenant + GET /usage via the tenant client),
    billing (Stripe Checkout + billing portal, from the billing-config read), and API keys (operator-managed for now).
    Never a 500 when unlinked; the API key is treated
    like a password — posted, validated, stored encrypted, and never echoed back or logged.
*@
<div class="page-header">
    <h1 class="page-title">Account &amp; usage</h1>
</div>

@if (ShowLinked)
{
    <div class="alert alert-success mt-3" role="status" data-testid="link-success">
        <div class="d-flex">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
            </div>
            <div>Workspace linked. Your plan and usage are shown below.</div>
        </div>
    </div>
}

<!-- Profile -->
<div class="card mt-3" id="profile">
    <div class="card-header"><h3 class="card-title">Profile</h3></div>
    <div class="card-body">
        <dl class="account-kv mb-0">
            <dt>Signed in as</dt>
            <dd data-testid="account-email">@Email</dd>

            <dt>Workspace</dt>
            <dd>
                @if (_relinkNeeded)
                {
                    <span class="status status-yellow" data-testid="link-status">
                        <span class="status-dot"></span>Re-link required
                    </span>
                }
                else if (_linked)
                {
                    <span class="status status-green" data-testid="link-status">
                        <span class="status-dot"></span>Linked to <span class="fw-semibold ms-1">@_tenantId</span>
                    </span>
                }
                else
                {
                    <span class="status status-secondary" data-testid="link-status">
                        <span class="status-dot"></span>Not linked
                    </span>
                }
            </dd>

            <dt>Session</dt>
            <dd>
                @* Reuse the existing sign-out endpoint (same antiforgery-protected POST the shell header uses). *@
                <form method="post" action="/auth/signout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary btn-sm" data-testid="account-sign-out">Sign out</button>
                </form>
            </dd>
        </dl>
    </div>
</div>

<!-- Workspace link -->
<div class="card mt-3" id="workspace-link">
    <div class="card-header">
        <h3 class="card-title">@(_linked ? "Update workspace link" : "Link your workspace")</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary">
            Paste your Crawldad workspace ID and a tenant API key. We verify the key against the API before saving it —
            it is stored encrypted at rest and never shown again.
        </p>

        @if (_error is not null)
        {
            <div class="alert alert-danger" role="alert" data-testid="link-error">@_error</div>
        }

        <EditForm id="link-form" Model="Input" FormName="workspace-link" OnValidSubmit="HandleLinkAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="tenantId">Workspace ID</label>
                    <InputText id="tenantId" class="form-control" autocomplete="off" spellcheck="false" @bind-Value="Input.TenantId" />
                    <ValidationMessage For="() => Input.TenantId" />
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="apiKey">API key</label>
                    @* Manual input with no value attribute: the secret binds IN on POST but is never rendered back OUT. *@
                    <input id="apiKey" name="Input.ApiKey" type="password" class="form-control" autocomplete="off" spellcheck="false" placeholder="Paste your API key" />
                    <ValidationMessage For="() => Input.ApiKey" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary" data-testid="link-submit">
                    @(_linked ? "Re-verify & update" : "Verify & link")
                </button>
            </div>
        </EditForm>
    </div>
</div>

<!-- Plan & usage -->
<div class="card mt-3" id="usage">
    <div class="card-header">
        <h3 class="card-title">Plan &amp; usage</h3>
        @if (_linked && _profile is not null)
        {
            <div class="card-actions text-secondary small">@PlanLabel(_profile) · live</div>
        }
    </div>
    <div class="card-body">
        @if (_relinkNeeded)
        {
            <div class="empty" data-testid="usage-relink">
                <p class="empty-title">Your saved key can't be read</p>
                <p class="empty-subtitle text-secondary">
                    We couldn't decrypt your stored API key (the portal's encryption key was rotated). Re-link your
                    workspace above with a current key to restore access — your data is safe.
                </p>
                <div class="empty-action">
                    <a href="#workspace-link" class="btn btn-primary">Re-link your workspace</a>
                </div>
            </div>
        }
        else if (!_linked)
        {
            <div class="empty" data-testid="usage-unlinked">
                <p class="empty-title">No usage yet</p>
                <p class="empty-subtitle text-secondary">
                    Link your workspace above to see live slot occupancy, queue depth, and your guardrails.
                </p>
                <div class="empty-action">
                    <a href="#workspace-link" class="btn btn-primary">Link your workspace</a>
                </div>
            </div>
        }
        else if (_usageError)
        {
            <div class="empty" data-testid="usage-error">
                <p class="empty-title">Usage is unavailable right now</p>
                <p class="empty-subtitle text-secondary">
                    We couldn't read your usage from the API. Your link is saved — try again shortly, or re-verify your
                    key above if it was rotated.
                </p>
            </div>
        }
        else
        {
            // Reached only when linked with no load error, so both are set — capture non-null locals for the panel.
            var usage = _usage!;
            var profile = _profile!;
            <div class="row g-3" data-testid="usage-panel">
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">Slots in use</div>
                        <div class="kpi" data-testid="usage-slots">@usage.Slots.InUse <span class="kpi-of">/ @usage.Slots.Allowance</span></div>
                        <div class="meter mt-2"><span style="width:@(Pct(usage.Slots.InUse, usage.Slots.Allowance))%"></span></div>
                        <div class="text-secondary kpi-note">Concurrent runs admitted right now.</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">Queue depth</div>
                        <div class="kpi" data-testid="usage-queue">@usage.Queue.Depth <span class="kpi-of">/ @profile.QueueDepthAllowance</span></div>
                        <div class="meter mt-2"><span style="width:@(Pct(usage.Queue.Depth, profile.QueueDepthAllowance))%"></span></div>
                        <div class="text-secondary kpi-note">Runs wait here at the slot cap — no 429 until it fills.</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="datacard h-100">
                        <div class="kpi-sub">p95 queue wait</div>
                        <div class="kpi" data-testid="usage-p95">@FormatWait(usage.Queue.P95WaitMs)</div>
                        <div class="text-secondary kpi-note">Across @usage.Queue.Sampled promoted run(s). Sustained wait is the "add slots" signal.</div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="fw-semibold mb-3">Guardrails <span class="text-secondary fw-normal small">— headroom before the hard ceilings</span></div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="small">Events / run (peak)</span>
                            <span class="mono small" data-testid="usage-events">@usage.Events.Max <span class="text-secondary">/ @usage.Events.Guardrail</span></span>
                        </div>
                        <div class="meter"><span style="width:@(Pct(usage.Events.Max, usage.Events.Guardrail))%"></span></div>
                        <div class="text-secondary kpi-note">Peak over the last @usage.Events.Sampled run(s) · avg @usage.Events.Avg.</div>
                    </div>
                    <div class="datacard">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="small">Runs started this month</span>
                            <span class="kpi-inline mono" data-testid="usage-runs">@usage.RunsStartedThisMonth</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="fw-semibold mb-3">Plan</div>
                    <dl class="account-kv">
                        <dt>Tier</dt>
                        <dd data-testid="plan-tier">@PlanLabel(profile)</dd>
                        <dt>Concurrent slots</dt>
                        <dd>@profile.SlotAllowance</dd>
                        <dt>Queue depth</dt>
                        <dd>@profile.QueueDepthAllowance</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

<!-- Billing -->
<div class="card mt-3" id="billing">
    <div class="card-header"><h3 class="card-title">Billing</h3></div>
    <div class="card-body">
        @if (!_linked || _relinkNeeded)
        {
            <div class="empty" data-testid="billing-unlinked">
                <p class="empty-title">Link your workspace to manage billing</p>
                <p class="empty-subtitle text-secondary">
                    Once your workspace is linked, upgrade your plan or open the billing portal from here.
                </p>
            </div>
        }
        else if (_billingConfig is not { Configured: true } billing)
        {
            <div class="empty" data-testid="billing-unavailable">
                <p class="empty-title">Billing not yet available</p>
                <p class="empty-subtitle text-secondary">
                    Plan changes, invoices, and payment method will open in Stripe. Nothing to do here yet.
                </p>
            </div>
        }
        else
        {
            <div data-testid="billing-panel">
                <p class="text-secondary">
                    Your plan is <span class="fw-semibold" data-testid="billing-current">@CurrentPlanLabel(billing)</span>.
                    Upgrading opens Stripe Checkout; "Manage billing" opens the Stripe billing portal. Your plan changes
                    only after checkout completes.
                </p>
                <div class="row g-3">
                    @foreach (var tier in billing.Tiers)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <div class="datacard h-100 @(tier.IsCurrent ? "border-primary" : "")">
                                <div class="fw-semibold">@tier.DisplayName</div>
                                <div class="kpi-inline">@tier.PriceLabel</div>
                                @if (tier.Slots is int slots)
                                {
                                    <div class="text-secondary small">@slots concurrent slots</div>
                                }
                                <div class="mt-2">
                                    @if (tier.IsCurrent)
                                    {
                                        <span class="badge bg-primary" data-testid="billing-tier-current">Current plan</span>
                                    }
                                    else if (tier.SelfServe)
                                    {
                                        <form method="post" action="/app/billing/checkout">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="tier" value="@tier.Tier" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm" data-testid="billing-upgrade-@tier.Tier">
                                                Choose @tier.DisplayName
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">Contact sales</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <form method="post" action="/app/billing/portal">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-primary" data-testid="billing-manage">Manage billing</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- API keys -->
<div class="card mt-3 mb-3" id="apikeys">
    <div class="card-header"><h3 class="card-title">API keys</h3></div>
    <div class="card-body">
        <p class="mb-1">
            API keys are issued, rotated, and revoked by the Crawldad operator today. Use one here to link your
            workspace above.
        </p>
        <p class="text-secondary mb-0 small">
            Self-service key management from the portal is on the roadmap. For your security, key material is never
            displayed here — the key you link is stored encrypted and shown to no one again.
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    // No initializer (BL0008): the framework binds this on POST; on GET it stays null so OnInitialized seeds a fresh one.
    [SupplyParameterFromForm]
    public WorkspaceLinkInput Input { get; set; } = default!;

    // Set by the post-link redirect (?linked=true) so a fresh GET can confirm the save that a redirect otherwise hides.
    [SupplyParameterFromQuery(Name = "linked")]
    public bool ShowLinked { get; set; }

    private bool _linked;
    private bool _relinkNeeded;
    private string? _tenantId;
    private TenantProfileResponse? _profile;
    private UsageResponse? _usage;
    private bool _usageError;
    private BillingConfigResponse? _billingConfig;
    private string? _error;

    private string? Email => HttpContext.User.FindFirstValue(ClaimTypes.Email);

    // The tier label, or a friendly default when the tenant has no configured tier. Called only where the profile is
    // known non-null (the header guard + the loaded-usage panel), so it takes the profile rather than reading a nullable.
    private static string PlanLabel(TenantProfileResponse profile) => profile.Tier ?? "Default";

    // The display name of the tenant's current tier from the billing catalog, or "Free" when none is marked current.
    private static string CurrentPlanLabel(BillingConfigResponse billing) =>
        billing.Tiers.FirstOrDefault(tier => tier.IsCurrent)?.DisplayName ?? "Free";

    protected override async Task OnInitializedAsync()
    {
        // No initializer on Input (BL0008): the framework binds it on a POST; on a GET it is null. Static SSR re-runs
        // this for every request, so the current link + usage are resolved here for both the GET and the form-post
        // re-render — the submit handler only redirects (on success) or sets an error (on failure).
        Input ??= new();
        await LoadAsync();
    }

    private async Task HandleLinkAsync()
    {
        var email = Email;
        if (string.IsNullOrWhiteSpace(email))
        {
            // Defensive: an [Authorize] principal always carries the email claim, but never trust a null into the store.
            _error = "Your session has expired. Sign in again to link a workspace.";
            return;
        }

        var result = await Linker.LinkAsync(email, Input.TenantId, Input.ApiKey, HttpContext.RequestAborted);
        if (result.Outcome == WorkspaceLinkOutcome.Linked)
        {
            // Post/Redirect/Get: a fresh GET re-resolves the now-linked tenant and shows usage, and avoids a form
            // re-post. Static SSR issues the redirect by throwing NavigationException; control does not return past here.
            Nav.NavigateTo("/app/account?linked=true", forceLoad: true);
            return;
        }

        _error = result.Message;
    }

    // Resolves the current link (if any) and, when linked, the live tenant profile + usage. Never throws for an
    // unlinked account (a clean not-linked state) nor for an API hiccup on a linked account (a friendly usage-error).
    private async Task LoadAsync()
    {
        PortalTenant? tenant;
        try
        {
            tenant = await Tenants.TryResolveAsync(HttpContext.RequestAborted);
        }
        catch (CryptographicException)
        {
            // The account IS linked, but its stored key can't be decrypted (the Data-Protection ring was rotated or
            // lost). That is a "re-link needed" prompt, never a 500 — the raw key is unrecoverable, so ask for a new one.
            _relinkNeeded = true;
            return;
        }

        if (tenant is null)
        {
            _linked = false;
            return;
        }

        _linked = true;
        _tenantId = tenant.TenantId;
        try
        {
            _profile = await tenant.Client.GetTenantAsync(HttpContext.RequestAborted);
            _usage = await tenant.Client.GetUsageAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            _usageError = true;
        }

        // Billing config is loaded independently of usage: a failure here degrades the billing card to a friendly
        // "not yet available" state without touching the usage panel (and a usage failure never hides the billing card).
        _billingConfig = await LoadBillingConfigAsync(tenant);
    }

    // The tenant's billing config, or null when the provider call fails — which the billing card renders as the friendly
    // "not yet available" state rather than a crash.
    private async Task<BillingConfigResponse?> LoadBillingConfigAsync(PortalTenant tenant)
    {
        try
        {
            return await tenant.Client.GetBillingConfigAsync(HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is CrawldadException or HttpRequestException)
        {
            return null;
        }
    }

    // Percentage (0..100) of value against a cap, guarding a zero/absent allowance.
    private static int Pct(long value, long max) => max <= 0 ? 0 : (int)Math.Min(100, Math.Round(100.0 * value / max));

    // A queue wait in ms as a compact human string: seconds under a minute, else minutes + seconds.
    private static string FormatWait(long ms)
    {
        var seconds = ms / 1000.0;
        return seconds < 60
            ? $"{seconds:0.0}s"
            : $"{(int)(seconds / 60)}m {(int)Math.Round(seconds % 60)}s";
    }
}
