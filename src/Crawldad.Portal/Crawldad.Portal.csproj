<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The customer-facing portal: a Blazor Web App (Interactive Server render mode, NO WebAssembly) with its
       own Marten document store on the shared Postgres, isolated in the "portal" schema. Self-contained: it does
       NOT reference Crawldad.Api or Crawldad.Contracts — the skeleton stands alone. -->

  <ItemGroup>
    <!-- Document storage for the portal's own users + OTP challenges. Marten is used standalone here (no
         Wolverine/event-store): the portal is a thin auth+shell host, not part of the API's message pipeline. -->
    <PackageReference Include="Marten" />
  </ItemGroup>

  <!-- White-box test access: the OTP code generator, hasher, and auth service are internal implementation detail
       exercised directly by the unit tests (the 100% gate covers them there). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Crawldad.Tests" />
  </ItemGroup>

</Project>
