<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The customer-facing portal: a Blazor Web App (Interactive Server render mode, NO WebAssembly) with its
       own Marten document store on the shared Postgres, isolated in the "portal" schema. It does NOT reference
       Crawldad.Api — it only ever reaches the API over HTTP through the typed Crawldad.Client SDK below. -->

  <ItemGroup>
    <!-- Document storage for the portal's own users, OTP challenges, and tenant links. Marten is used standalone
         here (no Wolverine/event-store): the portal is a thin auth+shell host, not part of the API's pipeline. -->
    <PackageReference Include="Marten" />
    <!-- Persist the portal's Data Protection key ring to a blob wrapped by a Key Vault key (issue #119),
         authenticated with the app's managed identity — so auth cookies AND the Data-Protected tenant API keys stored
         on PortalTenantLink survive a container restart/replace. Wired only when Crawldad:Portal:DataProtection is
         configured; absent config keeps the framework's default local ring (dev/tests untouched). Mirrors the API. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <!-- The typed .NET SDK the data pages call the Crawldad API through (pulls in Crawldad.Contracts transitively).
         The per-request client is built by IPortalTenantContext with the signed-in tenant's API key. -->
    <ProjectReference Include="..\Crawldad.Client\Crawldad.Client.csproj" />
  </ItemGroup>

  <!-- White-box test access: the OTP code generator, hasher, and auth service are internal implementation detail
       exercised directly by the unit tests (the 100% gate covers them there). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Crawldad.Tests" />
  </ItemGroup>

</Project>
