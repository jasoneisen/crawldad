<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- THE combined host: Wolverine.Http JSON API + Marten event store + JasperFx CLI. API-only (no Blazor). -->

  <ItemGroup>
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- Record/replay fake backend + the read-only DOM builtins parse captured HTML with AngleSharp. -->
    <PackageReference Include="AngleSharp" />
    <!-- The fake backend's structured-Sel `xpath` variant evaluates XPath over the AngleSharp DOM. -->
    <PackageReference Include="AngleSharp.XPath" />
    <!-- Phase 4 real backend adapters (local/browserless/browserbase) wrap Playwright for .NET. -->
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Payload validation-at-save: enforces schema/crawldad-1.schema.json against saved payloads. -->
    <PackageReference Include="JsonSchema.Net" />
    <!-- The durable Azure Blob storage adapter. The filesystem adapter is the hermetic default;
         this is the Azure-native durable seam for the Azure deployment target, tested against Azurite. -->
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <!-- The payload JSON Schema (Deliverable 1) is the normative structural spec. It lives once at the
       repo root and is embedded into this assembly so the save-time validator loads it with no file-path
       dependency; the same file is what an external tool/typed client would consume. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\schema\crawldad-1.schema.json" Link="crawldad-1.schema.json" LogicalName="crawldad-1.schema.json" />
    <!-- The committed llms.txt (repo root) is embedded so GET /llms.txt serves the exact checked-in
         bytes — one source of truth for the LLM-facing discovery index, no file-path dependency at runtime. -->
    <EmbeddedResource Include="..\..\llms.txt" Link="llms.txt" LogicalName="llms.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crawldad.Contracts\Crawldad.Contracts.csproj" />
  </ItemGroup>

  <!-- White-box test access: the interpreter node model, run scope, Sel resolver, and the fake backend are
       internal implementation detail exercised directly by the unit tests (the 100% gate covers them there). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Crawldad.Tests" />
  </ItemGroup>

  <!-- Ship the fixtures as content so the real host can run the P1 demo, and so they copy transitively
       into the test project's output (resolved at runtime via AppContext.BaseDirectory). Remove the SDK's
       default classification first (json→Content, html/md→None), then re-add all as copied Content — the
       one pattern that works regardless of extension without tripping the duplicate-item guard. -->
  <ItemGroup>
    <Content Remove="Fixtures\**\*" />
    <None Remove="Fixtures\**\*" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
