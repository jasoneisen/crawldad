{
  "manifest": "1",
  "description": "Record/replay script for a 3-page LJCMG CapHome enforcement search (LJCMGClient.cs:75-175 + HistoricalCrawler goToNextPageCallback :81-105). form → page1 → page2 → page3 (last). The search-button click and each pagination click emit a POST to CapHome.aspx (the postback waitForRequest matches). Pages 1-2 carry the pagination anchor in table.aca_pagination td:last-child; page3 does not (hasMorePages false). All results states report the same CapHome.aspx url, so the row-url scheme/host resolve to https://aca-prod.accela.com. No Chromium, no live traffic.",
  "initialState": "form",
  "states": {
    "form": {
      "gotoUrl": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx?module=Enforcement&TabName=Enforcement",
      "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx?module=Enforcement&TabName=Enforcement",
      "html": "form.html"
    },
    "page1": {
      "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx?module=Enforcement&TabName=Enforcement",
      "html": "page1.html"
    },
    "page2": {
      "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx?module=Enforcement&TabName=Enforcement",
      "html": "page2.html"
    },
    "page3": {
      "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx?module=Enforcement&TabName=Enforcement",
      "html": "page3.html"
    }
  },
  "transitions": [
    {
      "from": "form",
      "on": { "click": "#ctl00_PlaceHolderMain_btnNewSearch" },
      "to": "page1",
      "emit": { "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx", "method": "POST" }
    },
    {
      "from": "page1",
      "on": { "click": "table.aca_pagination td:last-child a" },
      "to": "page2",
      "emit": { "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx", "method": "POST" }
    },
    {
      "from": "page2",
      "on": { "click": "table.aca_pagination td:last-child a" },
      "to": "page3",
      "emit": { "url": "https://aca-prod.accela.com/LJCMG/Cap/CapHome.aspx", "method": "POST" }
    }
  ]
}
