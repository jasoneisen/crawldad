{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crawldad.dev/schema/crawldad-1.schema.json",
  "title": "Crawldad payload v1",
  "description": "Normative structure of a Crawldad v1 automation payload (CRAWLDAD_DESIGN.md §4-§6). Leaf expressions/templates are strings validated by the semantic pass, not this schema; this schema fixes the document shape, the node vocabulary (exactly one recognised head per node), and the mandatory loop safety cap.",
  "type": "object",
  "required": ["crawldad", "name", "config", "steps", "result"],
  "additionalProperties": false,
  "properties": {
    "crawldad": { "const": "1", "description": "Dialect version — v1 is frozen (§4)." },
    "name": { "type": "string", "minLength": 1, "description": "Logical identity of the managed payload (§4)." },
    "inputs": {
      "type": "object",
      "description": "Typed parameters bound at run time (§4).",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["string", "number", "boolean", "date", "array", "object", "backend", "storageTarget", "secretRef"] },
          "required": { "type": "boolean" },
          "default": true
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Session config (§8.1). Only `backend` (the adapter-resolution Expr) is required; every other block is optional and defaults per §8.1. The launch/context/route blocks become the SessionPolicy a real adapter applies (§9.2); `retry` drives the resilience layer (§8.3).",
      "required": ["backend"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "description": "Expr resolving to the { adapter, options } backend binding (§9)." },
        "defaultTimeoutMs": { "type": "integer", "minimum": 0, "description": "Context default timeout and the interpreter's timeout-hierarchy floor (§8.4); 120000 when absent." },
        "deadlineMs": { "type": "integer", "minimum": 1, "description": "Run wall-clock cap for an async run (§8.4/§11), enforced by the executor saga's timeout; a generous default (30 min) when absent." },
        "screenshotOnFailure": { "type": "boolean", "description": "Whether the executor captures a page screenshot on a step failure (§13), stored in deletable blob storage with only its ref in the trace; true when absent, set false to disable." },
        "launch": {
          "type": "object", "additionalProperties": false, "description": "Browser launch options passed to a launching backend (§9.2).",
          "properties": { "args": { "type": "array", "items": { "type": "string" }, "description": "Chromium launch args (e.g. --disable-web-security)." } }
        },
        "context": {
          "type": "object", "additionalProperties": false, "description": "Browser context options applied at connect (§9.2).",
          "properties": { "bypassCsp": { "type": "boolean", "description": "Bypass Content-Security-Policy (BypassCSP)." } }
        },
        "route": {
          "type": "object", "additionalProperties": false, "description": "Request-interception policy applied per page (§8.1): abort by host/resource type, else cache, else throttle.",
          "properties": {
            "blockHosts": { "type": "array", "items": { "type": "string" }, "description": "Hosts whose requests are aborted." },
            "blockResourceTypes": { "type": "array", "items": { "type": "string" }, "description": "Playwright resource types aborted wholesale (image/media/font)." },
            "cacheResourceTypes": { "type": "array", "items": { "type": "string" }, "description": "Resource types served from the cross-run asset cache (stylesheet/script)." },
            "cacheUrlSuffixes": { "type": "array", "items": { "type": "string" }, "description": "URL suffixes served from the cache (.html/.js)." },
            "throttle": {
              "type": "object", "additionalProperties": false, "description": "Global serialized throttle for non-cached requests.",
              "properties": { "minIntervalMs": { "type": "integer", "minimum": 0, "description": "Minimum spacing between non-cached requests; 0 disables throttling." } }
            }
          }
        },
        "retry": {
          "type": "object", "additionalProperties": false, "description": "Operation-level resilience (§8.3), wrapping the whole program.",
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "description": "Maximum attempts (Polly-style)." },
            "delayMs": { "type": "integer", "minimum": 0, "description": "Delay between attempts." },
            "backoff": { "type": "string", "description": "Backoff strategy (e.g. constant)." },
            "retryOn": { "type": "array", "items": { "type": "string" }, "description": "The only retryable conditions (timeout/pageCrashed); everything else is terminal." },
            "onPageCrashed": { "type": "string", "description": "Page-crash handling (reopenPage → close+reopen on the same context, §3.6)." }
          }
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "Initial variable bindings, evaluated once in order (§4). A string value is an Expr; a non-string is a JSON literal.",
      "additionalProperties": true
    },
    "steps": { "$ref": "#/$defs/block", "description": "The ordered program (§5, §6)." },
    "result": { "type": "string", "description": "Final Expr shaping the response body (§10)." }
  },
  "$defs": {
    "block": {
      "type": "array",
      "description": "An ordered list of nodes (a step list or a control-flow body).",
      "items": { "$ref": "#/$defs/node" }
    },
    "sel": {
      "description": "A selector (§5.2): a CSS/xpath string, or a structured object rooted at EXACTLY ONE of css/xpath/text/role/title/base, with optional refinements. `role` may carry an accessible-name `name`; `base` may pair with a relative `css` (the sole two-root combination). Only the keys the engine's SelResolver implements are permitted.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "css": { "type": "string" },
            "xpath": { "type": "string" },
            "text": { "type": "string" },
            "role": {
              "description": "An ARIA role (a fixed vocabulary, not a Tmpl) — page.GetByRole. The WAI-ARIA role set the real backend's AriaRole enum accepts, so an unknown role fails at save rather than run.",
              "enum": [
                "alert", "alertdialog", "application", "article", "banner", "blockquote", "button", "caption", "cell",
                "checkbox", "code", "columnheader", "combobox", "complementary", "contentinfo", "definition", "deletion",
                "dialog", "directory", "document", "emphasis", "feed", "figure", "form", "generic", "grid", "gridcell",
                "group", "heading", "img", "insertion", "link", "list", "listbox", "listitem", "log", "main", "marquee",
                "math", "menu", "menubar", "menuitem", "menuitemcheckbox", "menuitemradio", "meter", "navigation", "none",
                "note", "option", "paragraph", "presentation", "progressbar", "radio", "radiogroup", "region", "row",
                "rowgroup", "rowheader", "scrollbar", "search", "searchbox", "separator", "slider", "spinbutton", "status",
                "strong", "subscript", "superscript", "switch", "tab", "table", "tablist", "tabpanel", "term", "textbox",
                "time", "timer", "toolbar", "tooltip", "tree", "treegrid", "treeitem"
              ]
            },
            "name": { "type": "string" },
            "title": { "type": "string" },
            "base": { "type": "string" },
            "in": { "type": "string" },
            "nth": { "type": "string" },
            "first": { "type": "boolean" },
            "filter": {
              "type": "object",
              "required": ["hasTextRegex"],
              "additionalProperties": false,
              "properties": { "hasTextRegex": { "type": "string" } }
            }
          },
          "allOf": [
            { "$comment": "`name` is meaningful only as the accessible name of a `role`.",
              "if": { "required": ["name"] }, "then": { "required": ["role"] } }
          ],
          "oneOf": [
            { "$comment": "Rooted by a selector engine at the page/frame — exactly one root, and `base` absent.",
              "not": { "required": ["base"] },
              "oneOf": [
                { "required": ["css"] },
                { "required": ["xpath"] },
                { "required": ["text"] },
                { "required": ["role"] },
                { "required": ["title"] }
              ] },
            { "$comment": "Rooted at a bound handle — `base`, optionally narrowed by a relative `css`; no other root.",
              "required": ["base"],
              "allOf": [
                { "not": { "required": ["xpath"] } },
                { "not": { "required": ["text"] } },
                { "not": { "required": ["role"] } },
                { "not": { "required": ["title"] } }
              ] }
          ]
        }
      ]
    },
    "numExpr": {
      "description": "An integer loop bound (§6): either an Expr string that evaluates to a whole number, or a typed JSON number literal (CD-10). A number N behaves exactly as the Expr \"N\" (an integral literal ⇒ long, else double), so the two forms are interchangeable. The loop counter is an integer, so a non-integral value — a fractional literal (2.5) or a computed non-integer (5.0/2) — is a terminal type_error (§8.3, #33); a bare non-integral literal is rejected at save time with the same code, while an integral-valued double (2.0) is accepted and coerced.",
      "oneOf": [ { "type": "string" }, { "type": "number" } ]
    },
    "failure": {
      "type": "object",
      "description": "A typed failure payload (§4/§8.3).",
      "required": ["class", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["terminal", "retryable"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "node": {
      "description": "One step: an object with exactly one recognised head key (§5/§6). An unknown head, or more than one head, matches no branch and fails.",
      "type": "object",
      "oneOf": [
        { "required": ["comment"], "additionalProperties": false, "properties": { "comment": { "type": "string" } } },

        { "required": ["goto"], "additionalProperties": false, "properties": { "goto": {
          "type": "object", "required": ["url"], "additionalProperties": false,
          "properties": { "url": { "type": "string" }, "waitUntil": { "type": "string" }, "timeoutMs": { "type": "integer" } } } } },

        { "required": ["waitForLoadState"], "additionalProperties": false, "properties": { "waitForLoadState": {
          "type": "object", "required": ["state"], "additionalProperties": false,
          "properties": { "state": { "enum": ["load", "domcontentloaded", "networkidle"] }, "timeoutMs": { "type": "integer" } } } } },

        { "required": ["waitForRequest"], "additionalProperties": false, "properties": { "waitForRequest": {
          "type": "object", "required": ["urlPrefix", "trigger"], "additionalProperties": false,
          "properties": { "urlPrefix": { "type": "string" }, "method": { "type": "string" }, "timeoutMs": { "type": "integer" }, "trigger": { "$ref": "#/$defs/block" } } } } },

        { "required": ["waitFor"], "additionalProperties": false, "properties": { "waitFor": {
          "type": "object", "required": ["selector"], "additionalProperties": false,
          "properties": { "selector": { "$ref": "#/$defs/sel" }, "state": { "enum": ["visible", "hidden", "attached", "detached"] }, "in": { "type": "string" }, "timeoutMs": { "type": "integer" } } } } },

        { "required": ["frame"], "additionalProperties": false, "properties": { "frame": {
          "type": "object", "required": ["var", "selector"], "additionalProperties": false,
          "properties": { "var": { "type": "string" }, "selector": { "type": "string" } } } } },

        { "required": ["addStyleTag"], "additionalProperties": false, "properties": { "addStyleTag": {
          "type": "object", "required": ["content"], "additionalProperties": false,
          "properties": { "content": { "type": "string" } } } } },

        { "required": ["click"], "additionalProperties": false, "properties": { "click": {
          "type": "object", "required": ["selector"], "additionalProperties": false,
          "properties": { "selector": { "$ref": "#/$defs/sel" }, "in": { "type": "string" }, "timeoutMs": { "type": "integer" } } } } },

        { "required": ["fill"], "additionalProperties": false, "properties": { "fill": {
          "type": "object", "required": ["selector"], "additionalProperties": false,
          "description": "Type into a field (§5.1). Exactly one value source: `value` (an Expr, ordinary data) XOR `secret` (a `input.<name>` reference to a secretRef input, CD-6). A `secret` is resolved from the vault at fill time and never enters the expression value space; `value` and `secret` are mutually exclusive.",
          "properties": { "selector": { "$ref": "#/$defs/sel" }, "value": { "type": "string" }, "secret": { "type": "string", "description": "A `input.<name>` reference to a secretRef input; resolved from the vault at fill time (never interpolated, never an Expr)." }, "in": { "type": "string" } },
          "oneOf": [ { "required": ["value"] }, { "required": ["secret"] } ] } } },

        { "required": ["clear"], "additionalProperties": false, "properties": { "clear": {
          "type": "object", "required": ["selector"], "additionalProperties": false,
          "properties": { "selector": { "$ref": "#/$defs/sel" }, "in": { "type": "string" } } } } },

        { "required": ["screenshot"], "additionalProperties": false, "properties": { "screenshot": {
          "type": "object", "additionalProperties": false,
          "description": "Capture a full-page PNG to the tenant's deletable screenshot blob store (§13), recording only the content-addressed ref in the trace — the same seam, retention, and tenant partitioning as screenshot-on-failure (never the image, §12). `name` is an optional author label (Tmpl) carried into the trace/timeline to correlate the shot; it does not affect the content-addressed ref.",
          "properties": { "name": { "type": "string" } } } } },

        { "required": ["locate"], "additionalProperties": false, "properties": { "locate": {
          "type": "object", "required": ["var"], "additionalProperties": false,
          "properties": { "var": { "type": "string" }, "selector": { "$ref": "#/$defs/sel" }, "base": { "type": "string" }, "in": { "type": "string" }, "from": { "type": "string" }, "nth": { "type": "string" }, "first": { "type": "boolean" }, "filter": { "type": "object", "required": ["hasTextRegex"], "additionalProperties": false, "properties": { "hasTextRegex": { "type": "string" } } } },
          "anyOf": [ { "required": ["selector"] }, { "required": ["from"] } ] } } },

        { "required": ["download"], "additionalProperties": false, "properties": { "download": {
          "type": "object", "required": ["trigger", "to", "var"], "additionalProperties": false,
          "description": "Run `trigger`, capture the browser download it provokes, and stream the bytes to the `to` storageTarget under their content-addressed identity (§9.3). Storage is idempotent by content hash — an already-present blob short-circuits to `stored:true` with no re-upload — so a stable artifact is de-duplicated automatically, no author key required. (`idempotencyKey` was removed in CD-11: content addressing already delivers that `stored:true` dedup, and a pre-fetch key skip would need per-tenant key→blob state kept coherent with §12 retention plus author warrants against upstream drift and skipped trigger side-effects. See §9.3.)",
          "properties": { "trigger": { "$ref": "#/$defs/block" }, "to": { "type": "string" }, "var": { "type": "string" }, "timeoutMs": { "type": "integer" } } } } },

        { "required": ["set"], "additionalProperties": false, "properties": { "set": {
          "type": "object", "required": ["var", "value"], "additionalProperties": false,
          "properties": { "var": { "type": "string" }, "path": { "type": "string" }, "value": { "type": "string" } } } } },

        { "required": ["push"], "additionalProperties": false, "properties": { "push": {
          "type": "object", "required": ["into", "value"], "additionalProperties": false,
          "properties": { "into": { "type": "string" }, "value": { "type": "string" } } } } },

        { "required": ["log"], "additionalProperties": false, "properties": { "log": {
          "type": "object", "required": ["level", "message"], "additionalProperties": false,
          "properties": { "level": { "enum": ["info", "warning", "error"] }, "message": { "type": "string" } } } } },

        { "required": ["fail"], "additionalProperties": false, "properties": { "fail": { "$ref": "#/$defs/failure" } } },

        { "required": ["guard"], "additionalProperties": false, "properties": { "guard": {
          "type": "object", "required": ["cond", "elseFail"], "additionalProperties": false,
          "properties": { "cond": { "type": "string" }, "elseFail": { "$ref": "#/$defs/failure" } } } } },

        { "required": ["if"], "additionalProperties": false, "properties": { "if": {
          "type": "object", "required": ["cond", "then"], "additionalProperties": false,
          "properties": { "cond": { "type": "string" }, "then": { "$ref": "#/$defs/block" }, "else": { "$ref": "#/$defs/block" } } } } },

        { "required": ["switch"], "additionalProperties": false, "properties": { "switch": {
          "type": "object", "required": ["cases"], "additionalProperties": false,
          "properties": {
            "cases": { "type": "array", "items": { "type": "object", "required": ["when", "do"], "additionalProperties": false, "properties": { "when": { "type": "string" }, "do": { "$ref": "#/$defs/block" } } } },
            "default": { "$ref": "#/$defs/block" } } } } },

        { "required": ["loop"], "additionalProperties": false, "properties": { "loop": {
          "type": "object", "required": ["maxIterations", "do"], "additionalProperties": false,
          "properties": {
            "maxIterations": { "type": "integer", "minimum": 1 },
            "do": { "$ref": "#/$defs/block" },
            "onMaxIterations": { "enum": ["fail", "warn"] },
            "for": {
              "type": "object", "required": ["var", "from", "to"], "additionalProperties": false,
              "properties": { "var": { "type": "string" }, "from": { "$ref": "#/$defs/numExpr" }, "to": { "$ref": "#/$defs/numExpr" }, "step": { "$ref": "#/$defs/numExpr" }, "inclusiveTo": { "type": "boolean" }, "exclusiveTo": { "type": "boolean" } }
            },
            "while": { "type": "string" }
          },
          "oneOf": [ { "required": ["for"] }, { "required": ["while"] } ] } } },

        { "required": ["forEach"], "additionalProperties": false, "properties": { "forEach": {
          "type": "object", "required": ["in", "as", "do", "maxIterations"], "additionalProperties": false,
          "properties": { "in": { "type": "string" }, "as": { "type": "string" }, "index": { "type": "string" }, "do": { "$ref": "#/$defs/block" }, "maxIterations": { "type": "integer", "minimum": 1 }, "onMaxIterations": { "enum": ["fail", "warn"] } } } } },

        { "required": ["break"], "additionalProperties": false, "properties": { "break": {
          "type": "object", "additionalProperties": false, "properties": { "when": { "type": "string" } } } } },

        { "required": ["continue"], "additionalProperties": false, "properties": { "continue": {
          "type": "object", "additionalProperties": false, "properties": { "when": { "type": "string" } } } } },

        { "required": ["checkpoint"], "additionalProperties": false, "properties": { "checkpoint": {
          "type": "object", "required": ["name", "cursor"], "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "The checkpoint's stable name — the durable resume anchor (§11)." },
            "cursor": { "type": "string", "description": "Expr → the resumable cursor value persisted at this savepoint (a page cursor / resume URL)." },
            "resume": { "$ref": "#/$defs/block", "description": "Nodes run ONLY on resume, before the enclosing loop continues, to re-establish the browser at the cursor; the restored cursor is bound to the `checkpoint` var (§11)." }
          } } } }
      ]
    }
  }
}
