# The lint ruleset. With EnforceCodeStyleInBuild + TreatWarningsAsErrors, these severities
# are enforced at build time and by `dotnet format --verify-no-changes`.
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{json,yml,yaml,csproj,props,targets,razor,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Modern C# idioms
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_prefer_simple_using_statement = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Public methods are framework entry points (Wolverine endpoints/handlers) whose parameters are bound by the
# framework and may not all be referenced. Only flag unused params on non-public.
dotnet_code_quality_unused_parameters = non_public:warning

# Do not qualify with this.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Expression-bodied members are welcome (this codebase favors them)
csharp_style_expression_bodied_methods = true:silent
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# This is an application/service, not a shipped library: don't demand sealing/internal-by-default
# or CA1515 (public types). Keep the demonstrative public API readable.
dotnet_diagnostic.CA1515.severity = none
# ConfigureAwait(false) is for libraries; app/host code wants the captured context.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
# Nullable reference types are enabled, which already enforces non-null params at compile time;
# CA1062's defensive runtime null checks would be pure noise on every endpoint/handler.
dotnet_diagnostic.CA1062.severity = none
# LoggerMessage source-gen / deferred-evaluation micro-optimizations add ceremony for no benefit here.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Types instantiated only by DI or JSON deserialization look "never instantiated" to the analyzer.
dotnet_diagnostic.CA1812.severity = none
# We deliberately group small, cohesive types per feature file (Events.cs, Enums.cs, ...) for conciseness
# and discoverability, so don't require one-type-per-file-named-after-the-type.
dotnet_diagnostic.MA0048.severity = none

[src/Crawldad.Api/Infrastructure/Browser/**.cs]
# The browser seam mirrors Playwright for .NET 1:1 so the Phase 4 adapters map straight through: URLs,
# selectors, and wait-states are plain strings (a Playwright selector like "xpath=…" or a comma-union
# "#a, #b" is not a System.Uri). Turn off the URI-type design rules for this seam only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Api/Features/Runs/RunTraceEvents.cs]
# The Navigated trace event carries the page's (scrubbed) URL as a plain string — the same Playwright-style string URL
# the browser seam exempts: a trace value, not a System.Uri to construct/validate. Off for this file only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Api/Features/Webhooks/**.cs]
# A webhook target is a caller-supplied delivery URL carried and validated as a plain string: WebhookUrlPolicy checks
# scheme/host (SSRF) and surfaces a classified 400, so binding it as System.Uri would move malformed-URL handling into
# a model-binding fault instead. Same string-URL treatment as the browser connect string. Off for this slice only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Contracts/Webhooks/**.cs]
# The webhook wire contracts carry the delivery target as a plain string (the value the tenant registers and the SSRF
# policy validates), matching the slice above — not a System.Uri property to construct. Off for these contracts only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Api/Features/Billing/**.cs]
# A billing session / return URL is carried as a plain string: a provider-hosted redirect target, or — with the fake
# gateway — a RELATIVE in-app result path (not a valid absolute System.Uri). Same string-URL treatment as the webhook
# slice above; binding it as a Uri would break the relative fake case. Off for this slice only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Contracts/Billing/**.cs]
# The billing session response carries the redirect target as a plain string (a provider-hosted URL, or a relative
# in-app path with the fake gateway), matching the slice above — not a System.Uri property to construct. Off here only.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Api/Features/Billing/BillingNotConfiguredException.cs]
# BillingNotConfiguredException is a simple marker a billing endpoint catches to return a friendly 503; a single
# message-carrying constructor is its whole purpose. The parameterless / message+inner constructors CA1032 & RCS1194
# want would only add dead surface, so turn those two "standard exception constructor" rules off for this file only
# (mirrors NotLinkedException.cs / CrawldadExceptions.cs).
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.RCS1194.severity = none

[src/Crawldad.Client/CrawldadExceptions.cs]
# Every Crawldad API exception carries the HTTP status code (and most a typed rejection/problem body), so the
# parameterless / message-only / message+inner constructors CA1032 & RCS1194 want would only ever build
# semantically-invalid instances with a zero status and no body. The public surface is deliberately the
# status-carrying constructors, so turn those two "standard exception constructor" rules off for this file only.
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.RCS1194.severity = none

[src/Crawldad.Portal/Tenancy/NotLinkedException.cs]
# NotLinkedException is a simple marker the data pages catch; a single message-carrying constructor is its whole
# purpose. The parameterless / message+inner constructors CA1032 & RCS1194 want would only add dead surface, so
# turn those two "standard exception constructor" rules off for this file only (mirrors CrawldadExceptions.cs).
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.RCS1194.severity = none

[src/Crawldad.Portal/Auth/EmailDeliveryException.cs]
# EmailDeliveryException carries only a delivery-failure message (and, for a transport fault, the inner
# HttpRequestException) — the two constructors PostmarkEmailSender actually throws. The parameterless constructor
# CA1032 wants would only build a semantically-invalid instance, so turn those two "standard exception constructor"
# rules off for this file only (mirrors NotLinkedException.cs / CrawldadExceptions.cs).
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.RCS1194.severity = none

[src/Crawldad.Portal/Auth/**.cs]
# Email addresses are stored case-folded to their canonical lower-invariant form (the account identity/key).
# CA1308 prefers ToUpperInvariant for normalization, which is the wrong casing for an email key. Off here only.
dotnet_diagnostic.CA1308.severity = none
# The post-sign-in ReturnUrl is a same-site relative PATH carried through the form and validated as local by
# SafeRedirect — a plain string, not a System.Uri to construct. CA1054/CA1056 are folder-scoped elsewhere (the
# API's browser/webhook slices), never global, so this scope needs its own.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[src/Crawldad.Portal/Components/Pages/App/**.cs]
# The webhook register form binds the caller-supplied delivery URL as a plain string, then hands it to the API where
# WebhookUrlPolicy validates scheme/host (SSRF) and returns a classified 400 — the same string-URL treatment the API's
# webhook slice and its wire contracts use. Binding it as System.Uri would turn a malformed URL into a model-binding
# fault instead of that classified rejection. Off for this pages folder only (mirrors the Auth ReturnUrl scope).
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[tests/**.cs]
# Tests legitimately have public fixtures, magic values, short-lived disposables, and unused-looking params.
dotnet_diagnostic.CA1707.severity = none   # underscores in test method names
dotnet_diagnostic.CA1861.severity = none   # constant arrays as arguments
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait not needed in tests
dotnet_diagnostic.CA2000.severity = none   # short-lived HttpClient/handler in test helpers
dotnet_diagnostic.CA1869.severity = none   # one-off JsonSerializerOptions in tests
dotnet_diagnostic.CA1711.severity = none   # xUnit collection classes conventionally end in 'Collection'
dotnet_diagnostic.CA1308.severity = none   # tests deliberately lower-case inputs to exercise case-insensitive handling
